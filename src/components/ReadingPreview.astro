---
import books from '../data/bookshelf.json';
import RatingIcon from './RatingIcon.astro';
import AnimatedBookCover from './AnimatedBookCover.astro';
const sunrise = books.find(b => b.id === 'hunger-5')!;
const ratings = [
  {key:'overall',label:'Overall',icon:'star' as const,value:5},
  {key:'romance',label:'Romance',icon:'heart' as const,value:2},
  {key:'adventure',label:'Adventure',icon:'compass' as const,value:4},
  {key:'mystery',label:'Mystery',icon:'mystery' as const,value:3},
];
---
<div class="reading-preview" data-reading-preview>
  <div class="preview-introduction"><p class="preview-kicker">YOUR JOURNAL. YOUR PEOPLE.</p><h3>A little space for everything a book leaves behind.</h3><p>A page for every book, a place for every thought. Capture how a story made you feel, keep adding to it, and return to your words whenever you want.</p><span class="sample-label">Interactive concept preview · sample journal and fictional profiles</span></div>
  <div class="journal-community-grid">
    <div class="journal-column"><h4 class="column-slogan">A space that’s just yours.</h4>
    <article class="journal-paper" data-journal-paper aria-labelledby="journal-preview-title">
      <span class="paper-tape" aria-hidden="true"></span><div class="journal-summary" data-journal-summary>
      <header class="journal-header"><AnimatedBookCover cover={sunrise.cover} title={sunrise.title}/><div><span class="journal-eyebrow">MY READING JOURNAL</span><h4 id="journal-preview-title">Sunrise on the Reaping</h4><p>Suzanne Collins · The Hunger Games</p><span class="private-badge"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="7" width="8" height="7" rx="1.5" stroke="currentColor"/><path d="M5.5 7V4.5a2.5 2.5 0 0 1 5 0V7" stroke="currentColor"/></svg>Private journal</span></div></header>
      <div class="journal-metadata">
        <label>Reading language<input aria-label="Reading language" value="English" /></label>
        <label>Reading time<input aria-label="Reading time" value="Five evenings" /></label>
        <label>Favourite character<input aria-label="Favourite character" value="Haymitch Abernathy" /></label>
        <label>Least favourite character<input aria-label="Least favourite character" value="President Snow" /></label>
      </div>
      <label class="journal-field">Favourite quote<input class="journal-quote" aria-label="Favourite quote" placeholder="Save a line from your own copy…" /></label>
      <label class="journal-field">What didn’t work for me<textarea aria-label="What did not work for me" rows="2">How powerless everyone feels. I kept wishing the story could take a different turn.</textarea></label>

      </div>
      <div class="journal-unfold" id="journal-more" data-journal-unfold aria-hidden="true"><div class="journal-unfold-inner" data-journal-more inert>
      <div class="thoughts-heading"><label for="sample-reading-thoughts">My thoughts</label><span>Make the page feel like you.</span></div>
      <div class="writing-tools" role="toolbar" aria-label="Personalise your journal">
        <label class="tool-select"><span class="sr-only">Journal font</span><select data-journal-font aria-label="Journal font"><option value="handwritten">Handwritten</option><option value="bookish">Bookish</option><option value="simple">Simple</option></select></label>
        <button type="button" data-format="bold" aria-label="Bold selected text"><strong>B</strong></button><button type="button" data-format="underline" aria-label="Underline selected text"><u>U</u></button><button type="button" data-format="highlight" aria-label="Highlight selected text"><span class="highlight-symbol">ab</span></button>
        <label class="tool-select size-select"><span class="sr-only">Text size</span><select data-journal-size aria-label="Text size"><option value="20">A</option><option value="24">A+</option><option value="28">A++</option></select></label>
      </div>
      <div class="written-thoughts" id="sample-reading-thoughts" contenteditable="true" role="textbox" aria-label="My reading thoughts" aria-multiline="true" data-journal-editor><p>I went in knowing the name Haymitch. I came out wanting to sit quietly with everything he had to carry.</p><p>Some stories <u>don’t end when the last page does.</u></p></div>
      <div class="journal-share-row"><span data-journal-helper aria-live="polite">Highlight a passage to share it. The rest stays yours.</span><button class="share-passage" type="button" data-share-selection>Share a thought <span aria-hidden="true">↗</span></button></div>
      <div class="ratings-section"><p class="rating-caption">How it made me feel</p>{ratings.map(row=><div class={`rating-row rating-${row.key}`}><span>{row.label}</span><div class="rating-icons" role="radiogroup" aria-label={`${row.label} rating`} data-rating-row={row.key}>{Array.from({length:5},(_,i)=><button type="button" class:list={['rating-choice',{'is-coloured':i<row.value}]} role="radio" aria-checked={i+1===row.value?'true':'false'} aria-label={`${i+1} out of 5`} data-rating-value={i+1}><RatingIcon kind={row.icon}/></button>)}</div></div>)}</div>
      <button class="open-book-forum" type="button" data-open-book-forum>Still thinking about this book? Find your people <span aria-hidden="true">↗</span></button>
      </div></div>


    </article>
      <button class="unroll-journal" type="button" data-unroll-journal aria-expanded="false" aria-controls="journal-more"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 4v23M6 17l10 10 10-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span data-unroll-label>Click here</span></button>
    </div>
    <div class="community-preview" aria-labelledby="community-preview-title"><h4 class="column-slogan">Share only what feels right.</h4><div class="community-main" data-community-main>
      <article class="reader-profile"><div class="reader-avatar" aria-hidden="true">M<span>✧</span></div><div><span class="sample-profile">DEMO PROFILE</span><h4 id="community-preview-title">Mia’s reading corner</h4><p>@miasbetweenpages</p></div></article>
      <div class="community-tabs" role="group" aria-label="Explore the community preview"><button type="button" data-community-tab="thoughts" aria-pressed="true">Shared thoughts</button><button type="button" data-community-tab="forum" aria-pressed="false">Book discussion</button></div>
      <div class="share-review" data-share-review hidden><span class="community-eyebrow">YOUR CHOSEN PASSAGE</span><p data-share-review-text></p><small>Only this passage will appear in the demo community. Your other notes stay private.</small><div><button type="button" data-confirm-share>Share this thought</button><button type="button" class="cancel-share" data-cancel-share>Keep it private</button></div></div>
      <div data-community-panel="thoughts" class="shared-thoughts-panel">
        <div data-shared-feed>
          <article class="shared-thought"><header><span class="tiny-avatar blush" aria-hidden="true">M</span><div><strong>Mia</strong><span>Sample passage · Chosen from her journal</span></div></header><span class="thought-book-tag">Sunrise on the Reaping · Spoiler-free</span><p>I wanted somewhere to keep the version of me that existed while I was reading this.</p><button type="button" class="felt-it" data-felt-it aria-pressed="false">♡ I felt this too</button></article>
        </div>
        <p class="community-note"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2 3 4v4c0 3 5 6 5 6s5-3 5-6V4Z" stroke="currentColor"/></svg>Your diary is private. Your shared words are your choice.</p>
      </div>
      <div class="book-forum" data-community-panel="forum" hidden>
        <figure class="forum-art"><img class="forum-landscape" src="/images/sunrise-discussion-concept.png" alt="An imagined scene of young companions looking toward a sunrise over a forest and mining town" width="1774" height="887" loading="lazy"/><img class="forum-cover" src={sunrise.cover} alt="Sunrise on the Reaping cover" width="180" height="270" loading="lazy"/><figcaption>Imagining the story · concept artwork</figcaption></figure>
        <div class="forum-heading"><span class="community-eyebrow">THE HUNGER GAMES / BOOK DISCUSSION</span><h5>Sunrise on the Reaping</h5></div>
        <article class="forum-reply discussion-question"><strong>Mia <span>· Sample reader</span></strong><p>The feeling, more than any single scene. I’m glad there’s a place to talk about it.</p></article>
        <div class="discussion-unfold" data-discussion-unfold aria-hidden="true"><div class="discussion-unfold-inner" data-discussion-more inert>
          <div class="forum-guidelines">Keep it kind. Mark spoilers. Make room for a different feeling.</div>
          <div data-forum-replies><article class="forum-reply"><strong>Lena <span>· Sample reply</span></strong><p>Same here. Sometimes it helps just to know someone else felt it too.</p></article></div>
          <form class="forum-form" data-forum-form><label for="demo-forum-reply">Add your thought</label><textarea id="demo-forum-reply" name="thought" rows="3" placeholder="What did this story leave with you?" required maxlength="1200"></textarea><button type="submit">Add to the demo discussion</button><span data-forum-status aria-live="polite"></span></form>
        </div></div>

      </div>
      </div><button class="unroll-journal discussion-toggle" type="button" data-unroll-discussion aria-expanded="false"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 4v23M6 17l10 10 10-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span data-discussion-label>Click here to view the conversation</span></button>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-reading-preview]').forEach(preview=>{
    const editor=preview.querySelector<HTMLElement>('[data-journal-editor]')!;const paper=preview.querySelector<HTMLElement>('[data-journal-paper]')!;const helper=preview.querySelector<HTMLElement>('[data-journal-helper]')!;const shareReview=preview.querySelector<HTMLElement>('[data-share-review]')!;const shareText=preview.querySelector<HTMLElement>('[data-share-review-text]')!;
    const unroll=preview.querySelector<HTMLButtonElement>('[data-unroll-journal]')!;
    const unfold=preview.querySelector<HTMLElement>('[data-journal-unfold]')!;
    const more=preview.querySelector<HTMLElement>('[data-journal-more]')!;
    function setJournalExpanded(expanded:boolean){unroll.setAttribute('aria-expanded',String(expanded));unfold.setAttribute('aria-hidden',String(!expanded));more.inert=!expanded;paper.classList.toggle('is-unrolled',expanded);preview.querySelector('[data-unroll-label]')!.textContent=expanded?'Show less':'Click here';}
    unroll.addEventListener('click',()=>{setJournalExpanded(unroll.getAttribute('aria-expanded')!=='true');syncClosedHeight();});
    const discussionToggle=preview.querySelector<HTMLButtonElement>('[data-unroll-discussion]')!;
    function setForumExpanded(expanded:boolean){discussionToggle.setAttribute('aria-expanded',String(expanded));preview.querySelector('[data-discussion-unfold]')!.setAttribute('aria-hidden',String(!expanded));preview.querySelector<HTMLElement>('[data-discussion-more]')!.inert=!expanded;preview.querySelector('[data-discussion-label]')!.textContent=expanded?'Close the conversation':'Click here to view the conversation';}
    discussionToggle.addEventListener('click',()=>{showCommunity('forum');setForumExpanded(discussionToggle.getAttribute('aria-expanded')!=='true');syncClosedHeight();});

    const communityMain=preview.querySelector<HTMLElement>('[data-community-main]')!;
    const summary=preview.querySelector<HTMLElement>('[data-journal-summary]')!;
    function syncClosedHeight(){
      if(matchMedia('(max-width:760px)').matches){preview.style.removeProperty('--closed-preview-height');return;}
      if(unroll.getAttribute('aria-expanded')==='true'||discussionToggle.getAttribute('aria-expanded')==='true')return;
      preview.style.setProperty('--closed-preview-height','0px');
      const style=getComputedStyle(paper);const journalHeight=summary.getBoundingClientRect().height+parseFloat(style.paddingTop)+parseFloat(style.paddingBottom)+2;
      const extra=preview.querySelector<HTMLElement>('[data-discussion-unfold]')!;const extraHeight=extra.closest<HTMLElement>('[hidden]')?0:extra.getBoundingClientRect().height;
      const communityHeight=communityMain.scrollHeight-extraHeight;
      preview.style.setProperty('--closed-preview-height',Math.ceil(Math.max(journalHeight,communityHeight))+'px');
    }
    let syncing=false;const scheduleSync=()=>{if(syncing)return;syncing=true;requestAnimationFrame(()=>{syncing=false;syncClosedHeight();});};
    const sizeObserver=new ResizeObserver(scheduleSync);sizeObserver.observe(summary);sizeObserver.observe(communityMain);window.addEventListener('resize',scheduleSync);document.fonts.ready.then(scheduleSync);scheduleSync();
    let savedRange:Range|null=null;
    document.addEventListener('selectionchange',()=>{const selection=window.getSelection();if(selection?.rangeCount&&editor.contains(selection.anchorNode)&&editor.contains(selection.focusNode))savedRange=selection.getRangeAt(0).cloneRange();});
    function styleSelection(style:Record<string,string>){if(!savedRange||savedRange.collapsed||!editor.contains(savedRange.commonAncestorContainer)){helper.textContent='Highlight the words you’d like to personalise first.';return;}const range=savedRange.cloneRange();const span=document.createElement('span');Object.assign(span.style,style);span.append(range.extractContents());range.insertNode(span);const selection=window.getSelection();const updated=document.createRange();updated.selectNodeContents(span);selection?.removeAllRanges();selection?.addRange(updated);savedRange=updated;helper.textContent='A little more you. Choose any other words to style them.';}
    preview.querySelectorAll<HTMLButtonElement>('[data-format]').forEach(button=>{button.addEventListener('mousedown',event=>event.preventDefault());button.addEventListener('click',()=>{const styles:Record<string,Record<string,string>>={bold:{fontWeight:'700'},underline:{textDecoration:'underline',textDecorationColor:'#9b6b77',textUnderlineOffset:'3px'},highlight:{backgroundColor:'#eee1aa',borderRadius:'3px'}};styleSelection(styles[button.dataset.format!]);});});
    preview.querySelector<HTMLSelectElement>('[data-journal-font]')!.addEventListener('change',event=>{const fonts:Record<string,string>={handwritten:'"Patrick Hand", "Chalkboard SE", cursive',bookish:'Georgia, serif',simple:'system-ui, sans-serif'};paper.style.setProperty('--journal-font',fonts[(event.target as HTMLSelectElement).value]);});
    preview.querySelector<HTMLSelectElement>('[data-journal-size]')!.addEventListener('change',event=>{const size=(event.target as HTMLSelectElement).value+'px';if(savedRange&&!savedRange.collapsed)styleSelection({fontSize:size});else editor.style.fontSize=size;});
    preview.querySelectorAll<HTMLElement>('[data-rating-row]').forEach(row=>{const choices=Array.from(row.querySelectorAll<HTMLButtonElement>('[data-rating-value]'));choices.forEach(button=>button.addEventListener('click',()=>{const value=Number(button.dataset.ratingValue);choices.forEach(choice=>{choice.classList.toggle('is-coloured',Number(choice.dataset.ratingValue)<=value);choice.setAttribute('aria-checked',String(choice===button));});}));});
    function showCommunity(tab:string){preview.querySelectorAll<HTMLButtonElement>('[data-community-tab]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.communityTab===tab)));preview.querySelectorAll<HTMLElement>('[data-community-panel]').forEach(panel=>panel.hidden=panel.dataset.communityPanel!==tab);syncClosedHeight();}
    preview.querySelectorAll<HTMLButtonElement>('[data-community-tab]').forEach(button=>button.addEventListener('click',()=>showCommunity(button.dataset.communityTab!)));
    preview.querySelector('[data-open-book-forum]')!.addEventListener('click',()=>{showCommunity('forum');setForumExpanded(true);preview.querySelector<HTMLElement>('.book-forum')!.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth',block:'center'});});
    const shareButton=preview.querySelector<HTMLButtonElement>('[data-share-selection]')!;shareButton.addEventListener('mousedown',event=>event.preventDefault());shareButton.addEventListener('click',()=>{const text=savedRange&&!savedRange.collapsed&&editor.contains(savedRange.commonAncestorContainer)?savedRange.toString().trim():'';if(!text){helper.textContent='Highlight the passage you want to share. Your whole journal stays private.';return;}shareText.textContent=text;shareReview.hidden=false;showCommunity('thoughts');shareReview.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth',block:'center'});});
    preview.querySelector('[data-cancel-share]')!.addEventListener('click',()=>{shareReview.hidden=true;helper.textContent='Kept private. Your words stay in your journal.';});
    preview.querySelector('[data-confirm-share]')!.addEventListener('click',()=>{const card=document.createElement('article');card.className='shared-thought user-shared-thought';const header=document.createElement('header');const name=document.createElement('strong');name.textContent='You · Chosen from your journal';header.append(name);const tag=document.createElement('span');tag.className='thought-book-tag';tag.textContent='Sunrise on the Reaping · Demo passage';const text=document.createElement('p');text.textContent=shareText.textContent;card.append(header,tag,text);preview.querySelector('[data-shared-feed]')!.prepend(card);shareReview.hidden=true;helper.textContent='Only your chosen passage was shared in this demo. Your other notes stay private.';});
    preview.querySelectorAll<HTMLButtonElement>('[data-felt-it]').forEach(button=>button.addEventListener('click',()=>{const selected=button.getAttribute('aria-pressed')==='true';button.setAttribute('aria-pressed',String(!selected));button.textContent=selected?'♡ I felt this too':'♥ I felt this too';}));
    preview.querySelector<HTMLFormElement>('[data-forum-form]')!.addEventListener('submit',event=>{event.preventDefault();const input=preview.querySelector<HTMLTextAreaElement>('#demo-forum-reply')!;const value=input.value.trim();if(!value)return;const reply=document.createElement('article');reply.className='forum-reply user-forum-reply';const name=document.createElement('strong');name.textContent='You · Demo reply';const text=document.createElement('p');text.textContent=value;reply.append(name,text);preview.querySelector('[data-forum-replies]')!.append(reply);input.value='';preview.querySelector('[data-forum-status]')!.textContent='Added to this demo discussion.';});
  });
</script>
<style>
  @font-face {font-family:"Patrick Hand";src:url('/fonts/patrick-hand.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap;}
  @font-face {font-family:Caveat;src:url('/fonts/caveat.ttf') format('truetype');font-style:normal;font-weight:400 700;font-display:swap;}
  .reading-preview {margin-top:58px;color:#3c5744;} .preview-introduction {max-width:750px;margin-bottom:35px;}.preview-kicker {font-size:9px;letter-spacing:2px;color:#9a8967;font-weight:600;margin:0 0 15px;}.preview-introduction h3 {font:400 35px/1.15 Georgia,serif;letter-spacing:-1px;margin:0 0 15px;}.preview-introduction>p:not(.preview-kicker){font-size:13px;line-height:1.8;color:#7c8770;margin:0 0 12px;}.sample-label{display:inline-block;font-size:9px;color:#9a9a82;border-bottom:1px solid #d8d9c6;padding-bottom:5px;}
  .journal-community-grid {display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:40px;align-items:start;}.journal-paper{--journal-font:"Patrick Hand","Chalkboard SE",cursive;position:relative;padding:27px 25px 24px;margin-bottom:75px;background:repeating-linear-gradient(0deg,transparent 0 27px,#d7d3be33 27px 28px),linear-gradient(135deg,#fff9e9,#f8f0db);border:1px solid #ded3b5;border-radius:3px 12px 8px 3px;box-shadow:3px 5px 0 #eee7d2,6px 8px 0 #d6cfb470,0 18px 35px #51472b15;}.journal-paper::before{content:'';position:absolute;left:16px;top:0;bottom:0;width:1px;background:#c9989733;pointer-events:none;}.paper-tape{position:absolute;width:105px;height:25px;top:-11px;left:calc(50% - 52px);transform:rotate(-3deg);background:repeating-linear-gradient(90deg,#cbd3ad66 0 4px,#dfe3c16b 4px 7px);opacity:.85;box-shadow:0 1px 2px #68614215;}.journal-header{display:flex;gap:19px;align-items:center;margin-bottom:20px;}.journal-header>img{width:77px;height:115px;object-fit:cover;flex-shrink:0;transform:rotate(-4deg);box-shadow:-2px 4px 6px #40342333;border-radius:1px;}.journal-eyebrow{font-size:8px;letter-spacing:1.4px;color:#9a8969;}.journal-header h4{font:400 23px/1.15 Georgia,serif;letter-spacing:-.6px;margin:8px 0;}.journal-header p{font-size:10px;line-height:1.6;color:#85876f;margin:0 0 10px;}.private-badge{display:inline-flex;align-items:center;gap:5px;color:#688061;font-size:9px;}.private-badge svg{width:12px;height:12px;}
  .journal-metadata{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin-bottom:15px;}.journal-metadata label,.journal-field{display:block;font-size:9px;color:#929077;letter-spacing:.2px;}.journal-metadata input,.journal-field input,.journal-field textarea{display:block;width:100%;min-width:0;padding:4px 0 5px;border:0;border-bottom:1px solid #d6cfb4;background:transparent;border-radius:0;font-family:var(--journal-font);font-size:19px;line-height:1.2;color:#456044;outline-offset:3px;}.journal-field{margin-bottom:12px;}.journal-field textarea{resize:vertical;line-height:1.3;min-height:45px;}.journal-field input::placeholder{color:#a9a18a;font-style:italic;}.thoughts-heading{display:flex;justify-content:space-between;gap:10px;align-items:center;margin:20px 0 9px;}.thoughts-heading label{font-size:11px;color:#647855;}.thoughts-heading>span{font:17px var(--journal-font);color:#9b8d6f;}.writing-tools{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:6px 8px;border:1px solid #ddd7bd;border-radius:8px 8px 0 0;background:#efeedc88;}.writing-tools button{display:grid;place-items:center;padding:3px 7px;min-width:25px;height:25px;border:0;background:transparent;color:#6e7c5f;font:13px Georgia,serif;border-radius:4px;}.writing-tools button:hover{background:#dce3cc;}.tool-select select{border:0;max-width:120px;background:transparent;color:#67785c;font:10px system-ui,sans-serif;padding:4px 13px 4px 1px;}.highlight-symbol{background:#eee1aa;}.written-thoughts{padding:10px 11px;min-height:135px;font-family:var(--journal-font);font-size:20px;line-height:1.4;color:#3e5940;border:1px solid #ddd7bd;border-top:0;border-radius:0 0 8px 8px;background:#fffdf120;outline-offset:4px;}.written-thoughts p{margin:0 0 8px;}.written-thoughts p:last-child{margin-bottom:0;}.journal-share-row{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-top:12px;}.journal-share-row>span{font-size:9px;line-height:1.6;color:#97927c;max-width:240px;}.share-passage{flex-shrink:0;padding:0 0 4px;background:none;border:0;border-bottom:1px solid #a9b397;color:#5e7855;font-size:10px;}.share-passage span{margin-left:3px;}
  .ratings-section{margin-top:24px;padding-top:17px;border-top:1px dashed #cfc8ab;}.rating-caption{font:24px var(--journal-font);margin:0 0 10px;color:#6b7c57;}.rating-row{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:7px;}.rating-row>span{font-size:10px;color:#808269;}.rating-icons{display:flex;gap:5px;}.rating-choice{display:grid;place-items:center;padding:2px;width:25px;height:25px;border:0;background:none;color:#c9c6ad;cursor:pointer;}.rating-choice :global(svg){width:21px;height:21px;}.rating-choice :global(.icon-fill){fill:transparent;transition:fill .18s,color .18s;}.rating-choice.is-coloured{color:#ac9452;}.rating-choice.is-coloured :global(.icon-fill){fill:#e6d495;}.rating-romance .rating-choice.is-coloured{color:#b07b85;}.rating-romance .rating-choice.is-coloured :global(.icon-fill){fill:#dba3ac;}.rating-adventure .rating-choice.is-coloured{color:#72895b;}.rating-adventure .rating-choice.is-coloured :global(.icon-fill){fill:#d7dfba;}.rating-mystery .rating-choice.is-coloured{color:#7c8d92;}.rating-mystery .rating-choice.is-coloured :global(.icon-fill){fill:#c2d5d2;}.rating-choice:hover{transform:rotate(-5deg) scale(1.1);}.open-book-forum{margin-top:16px;padding:10px 0 0;border:0;border-top:1px dashed #cfc8ab;background:none;color:#788765;font-size:10px;line-height:1.7;text-align:left;width:100%;}.open-book-forum span{float:right;}
