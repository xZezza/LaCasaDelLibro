---
import books from '../data/popular-books.json';
---
<section class="popular-books" aria-labelledby="popular-title" data-popular-books data-playing="true">
  <div class="popular-heading"><div><p class="eyebrow">MORE THAN BOOKS. A PART OF YOU.</p><h2 id="popular-title">The stories you loved. The feelings you keep.</h2><p class="popular-description">The books that made you dream bigger, face your fears, laugh, cry and feel everything—all together on your own shelf.</p><p class="popular-description">Missing a world that stole your heart? In The Salon, you’ll be able to open a favourite, revisit your thoughts and return to the moments that made it unforgettable.</p></div></div>
  <div class="carousel-shell"><button class="carousel-arrow previous" type="button" data-carousel-direction="-1" aria-label="Previous books"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <div class="books-viewport" tabindex="0" aria-label="Fantasy and dystopian books. Hover or focus to pause. Select a book for an introduction.">
    <div class="books-track" data-books-track>
      {[true,false,true].map(duplicate => <div class="book-set" role={duplicate ? undefined : 'list'} aria-hidden={duplicate ? 'true' : undefined}>
        {books.map(book => <article class="popular-book" role={duplicate ? undefined : 'listitem'}><button class="book-preview-trigger" type="button" data-popular-id={book.id} tabindex={duplicate ? -1 : 0} aria-label={`Read about ${book.title} by ${book.author}`}>
          <span class="popular-cover"><img src={book.cover} alt="" width="180" height="270" loading="eager" decoding="async" /></span><span class="book-genre">{book.genre}</span><strong class="popular-title">{book.title}</strong><span class="book-author">{book.author}</span>
        </button></article>)}
      </div>)}
    </div>
  </div>
  <button class="carousel-arrow next" type="button" data-carousel-direction="1" aria-label="Next books"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 5 7 7-7 7M17 12H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>
  <dialog class="book-intro" data-book-intro aria-labelledby="intro-book-title"><button type="button" class="intro-close" data-close-intro aria-label="Close book introduction">×</button><div class="intro-content"><img class="intro-cover" data-intro-cover alt="" width="180" height="270" /><div><span class="intro-genre" data-intro-genre></span><h3 class="intro-title" id="intro-book-title" data-intro-title></h3><p class="intro-author" data-intro-author></p><p class="intro-collection" data-intro-collection></p><p class="intro-description" data-intro-description></p><a class="intro-source" data-intro-source target="_blank" rel="noreferrer">About this book</a></div></div></dialog>
</section>
<script>
  import books from '../data/popular-books.json';
  document.querySelectorAll<HTMLElement>('[data-popular-books]').forEach(section => {
    const dialog = section.querySelector<HTMLDialogElement>('[data-book-intro]')!;
    const viewport = section.querySelector<HTMLElement>('.books-viewport')!;
    let pointerOpened = false;
    let opener: HTMLButtonElement | null = null;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let hovered=false, focused=false, cycleWidth=0, pendingDistance=0, lastTime=0, wheelUntil=0;
    const firstSet=section.querySelector<HTMLElement>('.book-set')!;
    let measured=false;
    function measure(){const nextWidth=firstSet.getBoundingClientRect().width;if(nextWidth<=0)return;const oldWidth=cycleWidth;cycleWidth=nextWidth;viewport.scrollLeft=measured&&oldWidth?cycleWidth+(viewport.scrollLeft%oldWidth)/oldWidth*cycleWidth:cycleWidth;measured=true;}
    new ResizeObserver(measure).observe(firstSet);measure();
    function moveBy(distance:number){if(!cycleWidth)return;viewport.scrollLeft=cycleWidth+((viewport.scrollLeft-cycleWidth+distance)%cycleWidth+cycleWidth)%cycleWidth;}
    viewport.addEventListener('scroll',()=>{if(!cycleWidth)return;if(viewport.scrollLeft<cycleWidth-1)viewport.scrollLeft+=cycleWidth;else if(viewport.scrollLeft>=cycleWidth*2)viewport.scrollLeft-=cycleWidth;},{passive:true});
    viewport.addEventListener('pointerenter',()=>{hovered=true;});viewport.addEventListener('pointerleave',()=>{hovered=false;});
    viewport.addEventListener('focusin',()=>{focused=true;});viewport.addEventListener('focusout',event=>{focused=viewport.contains(event.relatedTarget as Node);});
    viewport.addEventListener('wheel',()=>{pendingDistance=0;wheelUntil=performance.now()+900;},{passive:true});
    viewport.addEventListener('touchstart',()=>{pendingDistance=0;wheelUntil=Infinity;},{passive:true});viewport.addEventListener('touchend',()=>{wheelUntil=performance.now()+1200;},{passive:true});
    function advance(direction:number){const distance=direction*Math.max(240,viewport.clientWidth*.65);if(reduceMotion.matches)moveBy(distance);else pendingDistance+=distance;}
    section.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]').forEach(button=>button.addEventListener('click',()=>advance(Number(button.dataset.carouselDirection))));
    viewport.addEventListener('keydown',event=>{if(event.target!==viewport)return;if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();advance(event.key==='ArrowLeft'?-1:1);}});
    function tick(time:number){const elapsed=Math.min(lastTime?time-lastTime:0,64);lastTime=time;const autoplay=!reduceMotion.matches&&!hovered&&!focused&&!dialog.open&&time>wheelUntil&&!document.hidden;if(Math.abs(pendingDistance)>.4){const step=pendingDistance*Math.min(elapsed/115,.4);moveBy(step);pendingDistance-=step;}else if(autoplay)moveBy(elapsed*.028);const state=String(autoplay);if(section.dataset.playing!==state)section.dataset.playing=state;requestAnimationFrame(tick);}
    requestAnimationFrame(tick);
    section.querySelectorAll<HTMLButtonElement>('[data-popular-id]').forEach(button => button.addEventListener('click',(event) => {
      pointerOpened = event.detail > 0; opener = button;
      const book = books.find(b => b.id === button.dataset.popularId);if (!book) return;
      const image = dialog.querySelector<HTMLImageElement>('[data-intro-cover]')!;image.src = book.cover;image.alt = `${book.title} cover`;
      dialog.querySelector('[data-intro-title]')!.textContent = book.title;dialog.querySelector('[data-intro-author]')!.textContent = book.author;dialog.querySelector('[data-intro-genre]')!.textContent = book.genre;dialog.querySelector('[data-intro-collection]')!.textContent = book.collection;dialog.querySelector('[data-intro-description]')!.textContent = book.description;dialog.querySelector<HTMLAnchorElement>('[data-intro-source]')!.href = book.summarySource;
      dialog.showModal();document.body.classList.add('dialog-open');
    }));
    dialog.querySelector('[data-close-intro]')!.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const b=dialog.getBoundingClientRect();if(event.clientX<b.left||event.clientX>b.right||event.clientY<b.top||event.clientY>b.bottom)dialog.close();});
    dialog.addEventListener('close',()=>{if(!document.querySelector('dialog[open]'))document.body.classList.remove('dialog-open'); if(pointerOpened){opener?.blur();} });
  });
</script>
<style>
  .popular-books { padding: 62px 0 32px; color: #304b3e; overflow: hidden; }
  .popular-heading { max-width: 1350px; margin: 0 auto 30px; padding: 0 5.5%; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
  .eyebrow { font-size: 9px; font-weight: 600; letter-spacing: 1.7px; color: #7d8c6e; margin: 0 0 15px; }
  h2 { font: 400 clamp(29px,3vw,43px)/1.15 Georgia,serif; letter-spacing: -1.2px; max-width: 760px; margin: 0; }
  .popular-description { max-width: 825px; font-size: 13px; line-height: 1.7; color: #7c8774; margin: 15px 0 0; }
  .books-viewport { overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-behavior: auto; scrollbar-width: none; padding: 8px 0 10px; mask-image: linear-gradient(90deg,transparent,#000 4% 96%,transparent); }.books-viewport::-webkit-scrollbar { display: none; }
  .books-track { display: flex; width: max-content;  }

  .book-set { display: flex; flex: 0 0 auto; align-items: flex-start; gap: 36px; padding-right: 36px; }
  .popular-book { flex: 0 0 152px; width: 152px; }
  .popular-cover { width: 144px; height: 216px; margin: 0 auto 17px; border-radius: 2px; position: relative; box-shadow: -3px 5px 7px #3e35292b; transform: perspective(650px) rotateY(-7deg); transition: transform .25s; }.popular-cover::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 3px 0 3px #ffffff22,inset 5px 0 2px #00000013; pointer-events: none; }
  .popular-cover img { display: block; width: 100%; height: 100%; object-fit: fill; border-radius: inherit; }.popular-book:hover .popular-cover { transform: perspective(650px) rotateY(0) translateY(-4px); }
  .book-genre { font-size: 8px; letter-spacing: .8px; text-transform: uppercase; color: #9b8a67; margin: 0 0 7px; }.popular-title { display: block; font: 400 17px/1.25 Georgia,serif; margin: 0 0 7px; }.book-author { display: block; font-size: 10px; color: #7d8875; margin: 0; }

  @media(max-width:960px) { .popular-books { padding-top: 40px; }.popular-heading { padding: 0 26px; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }h2 { font-size: 31px; }.popular-description { font-size: 11px; }.book-set { gap: 25px; padding-right: 25px; }.popular-book { width: 128px; flex-basis: 128px; }.popular-cover { width: 122px; height: 183px; }.popular-title { font-size: 16px; } }
  @media(prefers-reduced-motion:reduce) { .popular-cover { transition: none; } }

  .book-preview-trigger { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; }.book-preview-trigger:focus-visible { outline: 2px solid #829472; outline-offset: 5px; border-radius: 4px; }.popular-cover { display: block; }.book-genre { display: block; }
  .book-intro { width: min(670px,92vw); max-height: 90dvh; overflow: auto; padding: 30px; border: 1px solid #d6c9ac; border-radius: 20px; background: linear-gradient(135deg,#faf4e5,#f1e6ce); color: #36523e; box-shadow: 0 20px 90px #1c251b55; }.book-intro::backdrop { background: #213024ae; backdrop-filter: blur(6px); }.intro-close { position: absolute; top: 13px; right: 15px; width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; border: 1px solid #cdd1b8; background: transparent; color: #4b6249; font-size: 23px; }.intro-content { display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 28px; align-items: start; padding-top: 14px; }.intro-cover { display: block; width: 150px; height: 225px; object-fit: fill; border-radius: 2px; box-shadow: -2px 5px 9px #44342530; }.intro-genre { display: block; margin: 0 0 12px; font-size: 9px; text-transform: uppercase; letter-spacing: 1.2px; color: #a08b60; }.intro-title { font: 400 28px/1.12 Georgia,serif; margin: 0; letter-spacing: -.6px; }.intro-author { font-size: 12px; margin: 12px 0 6px; color: #64785b; }.intro-collection { font-size: 10px; margin: 0 0 18px; color: #90947a; }.intro-description { font-size: 13px; line-height: 1.8; color: #69745d; margin: 0; }.intro-source { display: inline-block; margin-top: 20px; font-size: 10px; color: #78866a; text-underline-offset: 3px; }
  @media(max-width:650px) { .book-intro { padding: 26px 22px; }.intro-content { grid-template-columns: 1fr; gap: 20px; }.intro-cover { width: 112px; height: 168px; margin: auto; }.intro-title { font-size: 27px; }.intro-description { font-size: 12px; } }

  .carousel-shell{position:relative;}.carousel-arrow{position:absolute;z-index:3;top:89px;display:grid;place-items:center;width:38px;height:38px;padding:8px;border:1px solid #cbd1bd99;border-radius:50%;background:#faf7eddd;backdrop-filter:blur(6px);color:#3e5c47;box-shadow:0 2px 12px #39452a15;}.carousel-arrow:hover{background:#fffaf0;color:#815d3c;}.carousel-arrow svg{width:23px;height:23px;}.carousel-arrow.previous{left:15px;}.carousel-arrow.next{right:15px;}
  @media(max-width:960px){.carousel-arrow{width:32px;height:32px;padding:5px;top:77px;}.carousel-arrow.previous{left:7px;}.carousel-arrow.next{right:7px;}}
</style>
