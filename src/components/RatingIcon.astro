---
const { kind } = Astro.props as { kind: 'star'|'heart'|'compass'|'mystery' };
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
  {kind === 'star' && <path class="icon-fill" d="m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.4l6.3-.9Z" />}
  {kind === 'heart' && <path class="icon-fill" d="M20.3 4.8a5 5 0 0 0-7.1 0L12 6l-1.2-1.2a5 5 0 0 0-7.1 7.1L12 20l8.3-8.1a5 5 0 0 0 0-7.1Z" />}
  {kind === 'compass' && <><circle class="icon-fill" cx="12" cy="12" r="9"/><path d="m15.8 8.2-2.1 5.5-5.5 2.1 2.1-5.5Z" fill="currentColor" stroke="none"/><path d="M12 1v2m0 18v2M1 12h2m18 0h2"/></>}
  {kind === 'mystery' && <><circle class="icon-fill" cx="10" cy="10" r="6.6"/><path d="m15 15 6 6" stroke-width="2" stroke-linecap="round"/></>}
</svg>
