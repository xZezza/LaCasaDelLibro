---
import books from '../data/bookshelf.json';
import spines from '../data/spines.json';
import SpineTexture from './SpineTexture.astro';
const rows = [['acotar', 'addie'], ['empyrean', 'hunger'], ['potter', 'divergent']];
const names: Record<string, string> = { acotar: 'ACOTAR', empyrean: 'The Empyrean', hunger: 'The Hunger Games', addie: 'Addie LaRue', potter: 'Harry Potter', divergent: 'Divergent' };
const spineData = spines as Record<string, {ratio: number}>;
const lights = Array.from({length: 23}, (_, i) => ({x: 8 + i * 26.5, y: 8 + Math.sin(i * Math.PI / 5) ** 2 * 9}));
function bookProps(book: typeof books[number]) {
  return { 'data-book-id': book.id, 'data-title': book.title, 'data-author': book.author, 'data-note': book.note, 'data-series-name': book.seriesName, 'data-reading-status': book.readingStatus, 'data-cover': book.cover, 'data-isbn': book.isbn, 'aria-label': `Preview ${book.title}, ${book.author}`, 'aria-pressed': 'false', draggable: 'false', style: `--spine-ratio:${spineData[book.id]?.ratio || .16};--height-offset:${book.series === 'potter' ? 0 : book.order % 2 * 3}px` };
}
---
<div class="shelf-preview" data-shelf-preview>
  <div class="preview-scene">
    <div class="real-bookshelf" data-bookcase data-layout="styled" aria-label="Example reading lists">
      <img class="cabinet-art" src="/images/cozy-oak-bookcase.png" width="1536" height="1024" alt="" aria-hidden="true" draggable="false"/>
      <svg class="shelf-lights" viewBox="0 0 600 32" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6Q100 30 200 6Q300 30 400 6Q500 30 600 6" fill="none" stroke="#b5a47f" />{lights.map(({x,y}) => <circle cx={x} cy={y} r="2.2" fill="#fff3c6" />)}</svg>
      {rows.map((row, rowIndex) => <div class="shelf-row" data-shelf-row={rowIndex}>
        {row.map((key) => <div class:list={['saga-cluster', { 'horizontal-cluster': key === 'addie' }]} data-series={key} aria-label={names[key]}>
          {books.filter((book) => book.series === key && !(key === 'divergent' && book.order > 1)).map((book) => <><button type="button" class:list={['shelf-book', { 'first-volume': book.order === 1 && key !== 'addie', 'cover-required': !spineData[book.id], 'horizontal-book': key === 'addie' }]} {...bookProps(book)}>
            <span class="spine-texture"><SpineTexture id={book.id} />{!spineData[book.id] && <span class="fallback-spine">{book.title}</span>}</span><img draggable="false" class="shelf-cover" src={book.cover} alt="" width={book.width} height={book.height} loading={book.order === 1 || !spineData[book.id] ? "eager" : "lazy"} decoding="async" />{book.id === 'potter-1' && <img class="necklace-prop" src="/images/hallows-necklace.png" alt="" aria-hidden="true" draggable="false" />}
          </button>{book.id === 'empyrean-1' && <button type="button" class="dragon-prop shelf-prop" data-shelf-prop="dragon" draggable="false" aria-label="Move the black dragon"><svg class="dragon-art" viewBox="209 8 680 1178" preserveAspectRatio="xMidYMax meet" aria-hidden="true"><image href="/images/black-dragon-ornament.png" width="1236" height="1272" /></svg></button>}</>)}
          {key === 'divergent' && <div class="stacked-volumes">{books.filter(b => b.series === key && b.order > 1).map(book => <button type="button" class="shelf-book stackable-book" {...bookProps(book)}><span class="spine-texture"><SpineTexture id={book.id} />{!spineData[book.id] && <span class="fallback-spine">{book.title}</span>}</span><img draggable="false" class="shelf-cover" src={book.cover} alt="" width={book.width} height={book.height} loading="lazy" decoding="async" /></button>)}</div>}

          {key === 'addie' && <span class="little-candle" aria-hidden="true"><i></i></span>}
        </div>)}
      </div>)}
      <button type="button" class="trailing-ivy shelf-prop" data-shelf-prop="plant" draggable="false" aria-label="Move the trailing plant"><img src="/images/trailing-ivy-cutout.png" alt="" draggable="false" /></button>
    </div>
    <div class="book-pane">
  <div class="preview-controls"><div class="layout-options reading-tabs" role="group" aria-label="Choose a reading list">
    <button type="button" data-reading-filter="read" aria-pressed="true"><span aria-hidden="true">✓</span> Read <small>18</small></button><button type="button" data-reading-filter="tbr" aria-pressed="false"><span aria-hidden="true">♡</span> To be read <small>9</small></button>
  </div></div>
    <aside class="cover-reveal" aria-label="3D book preview" aria-live="polite" aria-atomic="true">
      <div class="cover-placeholder" data-cover-placeholder><span aria-hidden="true">✧</span><p>A story is waiting.</p><small>Hover over a book,<br />or tap to take a look.</small></div>
      <div class="revealed-book" data-cover-content hidden>
        <div class="book-stage" data-model-stage draggable="false" role="group" aria-label="Drag this book onto a shelf to move it.">
          <div class="book-model" data-book-model style="--rotation:-28deg">
            <div class="model-back" aria-hidden="true"></div><div class="model-spine" data-model-spine aria-hidden="true"></div><div class="model-pages" aria-hidden="true"></div><div class="model-top" aria-hidden="true"></div><div class="model-bottom" aria-hidden="true"></div>
            <img draggable="false" class="model-front" data-revealed-cover alt="" width="180" height="270" />
          </div>
        </div>
        <strong data-selected-title></strong><span class="cover-author" data-selected-author></span><span class="cover-note" data-selected-detail></span>
      </div>
    </aside>
    </div>
  <p class="preview-hint" data-action-hint aria-live="polite"><span aria-hidden="true">✧</span> Drag to arrange. Double-click a book to show its cover or spine.</p>
  <details class="edition-notes">
    <summary>Book editions &amp; image credits</summary>
    <p>Read and To be read are example collections for this concept preview, not a saved personal reading history.</p>
    <p>Photographic spines preserve the artwork and lettering of real English-language editions. Where a matching spine photograph is not available, the book is displayed cover-forward. The 3D viewer models the cover, spine and page block; it does not reproduce the back-cover artwork.</p>
    <p>Real English-language editions, checked on 5 November 2026. Reading order follows publication order within each collection. Harry Potter contains the seven original novels; Addie LaRue is a standalone. The Empyrean includes <em>Threshing Day</em>, a companion collection, and Divergent includes <em>Four</em>.</p>
    <p>Series references: <a href="https://sarahjmaas.com/reading-guide/" target="_blank" rel="noreferrer">Sarah J. Maas</a>, <a href="https://rebeccayarros.com/empyrean" target="_blank" rel="noreferrer">Rebecca Yarros</a>, <a href="https://threshingday.com/" target="_blank" rel="noreferrer">Threshing Day</a>, <a href="https://www.scholastic.com/newsroom/online-press-kits/hunger-games-series.html" target="_blank" rel="noreferrer">Scholastic</a>, <a href="https://stories.jkrowling.com/faqs/" target="_blank" rel="noreferrer">J. K. Rowling</a>, <a href="https://veronicarothbooks.com/books/four/" target="_blank" rel="noreferrer">Veronica Roth</a>.</p>
    <p>Covers identify the books and remain the property of their respective rightsholders. Cover images are sourced from author/publisher sites and <a href="https://openlibrary.org/dev/docs/api/covers" target="_blank" rel="noreferrer">Open Library</a>. Editions can have different cover designs. This is an independent product preview.</p>
  <p>Spine photography: <a href="https://www.barnesandnoble.com/w/a-court-of-thorns-and-roses-paperback-box-set-sarah-j-maas/1140822689" target="_blank" rel="noreferrer">ACOTAR box set</a>, <a href="https://thereadingspa.com/products/harry-potter-complete-book-series-special-edition-boxed-set" target="_blank" rel="noreferrer">Harry Potter set</a>, <a href="https://www.lowplexbooks.com/products/the-hunger-games-series-by-suzanne-collins-5-books-collection-set" target="_blank" rel="noreferrer">Hunger Games set</a>, <a href="https://foxclouds.com/blog/tag/divergent" target="_blank" rel="noreferrer">Divergent set</a>, and PangoBooks edition photographs. Book-by-book provenance is retained in the project catalog; printings can differ.</p></details>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-shelf-preview]').forEach((preview) => {
    const books = Array.from(preview.querySelectorAll<HTMLButtonElement>('[data-book-id]'));
    const bookcase = preview.querySelector<HTMLElement>('[data-bookcase]')!;
    const controls = Array.from(preview.querySelectorAll<HTMLButtonElement>('[data-reading-filter]'));
    const clusters = Array.from(bookcase.querySelectorAll<HTMLElement>('[data-series]'));
    const rows = Array.from(bookcase.querySelectorAll<HTMLElement>('[data-shelf-row]'));
    const props = Array.from(preview.querySelectorAll<HTMLButtonElement>('[data-shelf-prop]'));
    const dragon = props.find(prop => prop.dataset.shelfProp === 'dragon')!;
    const plant = props.find(prop => prop.dataset.shelfProp === 'plant')!;
    const containers = [...rows, ...clusters, ...bookcase.querySelectorAll<HTMLElement>('.stacked-volumes')];
    const placeholder = preview.querySelector<HTMLElement>('[data-cover-placeholder]')!;
    const content = preview.querySelector<HTMLElement>('[data-cover-content]')!;
    const cover = preview.querySelector<HTMLImageElement>('[data-revealed-cover]')!;
    const model = preview.querySelector<HTMLElement>('[data-book-model]')!;
    const stage = preview.querySelector<HTMLElement>('[data-model-stage]')!;
    const modelSpine = preview.querySelector<HTMLElement>('[data-model-spine]')!;
    const hint = preview.querySelector<HTMLElement>('[data-action-hint]')!;
    const title = preview.querySelector<HTMLElement>('[data-selected-title]')!;
    const author = preview.querySelector<HTMLElement>('[data-selected-author]')!;
    const detail = preview.querySelector<HTMLElement>('[data-selected-detail]')!;
    const defaultHint = 'Drag to arrange. Double-click a book to show its cover or spine.';
    let selected: HTMLButtonElement | null = null;
    let displayed: HTMLButtonElement | null = null;
    let featured = books[0];
    let currentList = '';
    let dragging: HTMLButtonElement | null = null;
    let suppressClickUntil = 0;
    let ghost: HTMLElement | null = null;
    let pointerOrigin: {x: number; y: number; id: number; type: string; item: HTMLButtonElement} | null = null;
    function snapshot() {
      return {
        contents: containers.map(parent => ({parent, children: Array.from(parent.childNodes)})),
        states: [...books, ...clusters, ...rows, ...props].map(element => ({element, hidden: element.hidden, facing: element.dataset.facing, style: element.getAttribute('style')})),
        cabinetWidth: bookcase.style.width,
      };
    }
    type ShelfSnapshot = ReturnType<typeof snapshot>;
    function restore(saved: ShelfSnapshot) {
      saved.contents.forEach(({parent, children}) => parent.replaceChildren(...children));
      saved.states.forEach(({element, hidden, facing, style}) => {
        element.hidden = hidden;
        if (facing) element.dataset.facing = facing; else delete element.dataset.facing;
        if (style === null) element.removeAttribute('style'); else element.setAttribute('style', style);
      });
      bookcase.style.width = saved.cabinetWidth;
    }
    const initial = snapshot();
    const collections = new Map<string, ShelfSnapshot>();
    function lockCabinet() {
      if (bookcase.style.width) return;
      const width = bookcase.getBoundingClientRect().width;
      const height = (parseFloat(getComputedStyle(bookcase).height) - 58) / 2.89;
      if (width && height) bookcase.style.width = `calc(var(--book-height) * ${width / height})`;
    }
    function isVisible(element: HTMLElement) { return !!element.getClientRects().length; }
    function fits() {
      return rows.filter(isVisible).every(row => {
        const css = getComputedStyle(row);
        const top = parseFloat(css.paddingTop);
        const bottom = row.clientHeight - parseFloat(css.paddingBottom);
        return [...row.querySelectorAll<HTMLElement>('[data-book-id], [data-shelf-prop="dragon"]')].filter(isVisible).every(item => {
          // Offset geometry ignores hover animations and includes every nested group.
          let left = item.offsetLeft; let y = item.offsetTop;
          let parent = item.offsetParent as HTMLElement | null;
          while (parent && parent !== row) { left += parent.offsetLeft; y += parent.offsetTop; parent = parent.offsetParent as HTMLElement | null; }
          return left >= -1 && left + item.offsetWidth <= row.clientWidth + 1 && y >= top - 1 && y + item.offsetHeight <= bottom + 1;
        });
      });
    }
    function makeRoom(row: HTMLElement, incoming: HTMLButtonElement, canTurnIncoming = true) {
      if (fits()) return true;
      // Gaps between saga wrappers are decoration, not occupied shelf space.
      row.style.setProperty('--shelf-gap', '4px');
      row.style.setProperty('--book-gap', '1px');
      row.style.setProperty('--cover-gap', '1px');
      if (fits()) return true;
      const covers = books.filter(book => row.contains(book) && isVisible(book) && facing(book) === 'cover' && (canTurnIncoming || book !== incoming));
      // Preserve the book being moved whenever a neighbouring display cover can turn.
      for (const book of [...covers.filter(book => book !== incoming), ...covers.filter(book => book === incoming)]) {
        book.dataset.facing = 'spine';
        if (fits()) return true;
      }
      return false;
    }
    function select(book: HTMLButtonElement) {
      selected = book;
      books.forEach(other => other.setAttribute('aria-pressed', String(other === book)));
      reveal(book);
    }
    function reveal(book: HTMLButtonElement) {
      placeholder.hidden = true; content.hidden = false;
      if (book === displayed) return;
      displayed = book; cover.src = book.dataset.cover!; cover.alt = `${book.dataset.title} — edition cover`;
      title.textContent = book.dataset.title!; author.textContent = book.dataset.author!;
      detail.textContent = `${book.dataset.seriesName} · ${book.dataset.note}`;
      modelSpine.replaceChildren();
      const texture = book.querySelector('.spine-texture svg');
      if (texture) modelSpine.append(texture.cloneNode(true)); else modelSpine.textContent = book.dataset.title!;
      model.style.setProperty('--rotation', '-28deg');
    }
    function facing(book: HTMLButtonElement) {
      return book.dataset.facing || (book.classList.contains('first-volume') || book.classList.contains('cover-required') ? 'cover' : 'spine');
    }
    function turn(book: HTMLButtonElement) {
      lockCabinet();
      const saved = snapshot();
      const next = facing(book) === 'cover' ? 'spine' : 'cover';
      const stack = book.closest('.stacked-volumes');
      if (stack) stack.before(book);
      book.dataset.facing = next;
      const row = book.closest<HTMLElement>('[data-shelf-row]')!;
      if (!makeRoom(row, book, false)) { restore(saved); hint.textContent = 'A little more room is needed here. Move the book to another spot first.'; }
      else hint.textContent = defaultHint;
      select(book);
    }
    books.forEach(book => {
      book.title = 'Drag to move · Double-click to show cover or spine';
      book.addEventListener('pointerenter', event => { if (!dragging && event.pointerType !== 'touch') reveal(book); });
      book.addEventListener('focus', () => { if (!dragging) reveal(book); });
      book.addEventListener('click', event => { if (performance.now() < suppressClickUntil) { event.preventDefault(); return; } select(book); });
      book.addEventListener('dblclick', event => { event.preventDefault(); if (!dragging && performance.now() >= suppressClickUntil) turn(book); });
      book.addEventListener('keydown', event => { if (event.key === 'Enter' && event.shiftKey) { event.preventDefault(); turn(book); } });
    });
    stage.addEventListener('dblclick', event => { event.preventDefault(); turn(displayed || selected || featured); });
    function showList(status: string) {
      finishMove();
      if (currentList) collections.set(currentList, snapshot());
      selected = null; displayed = null;
      if (collections.has(status)) restore(collections.get(status)!);
      else {
        restore(initial);
        books.forEach(book => { book.hidden = book.dataset.readingStatus !== status; });
        clusters.forEach(cluster => { cluster.hidden = !Array.from(cluster.querySelectorAll<HTMLElement>('[data-book-id]')).some(book => !book.hidden); });
        const arrangement = status === 'read' ? [['acotar', 'empyrean', 'hunger'], ['potter', 'divergent']] : [['acotar', 'empyrean'], ['hunger', 'addie', 'divergent']];
        arrangement.forEach((keys, i) => { rows[i].hidden = false; keys.forEach(key => rows[i].append(clusters.find(cluster => cluster.dataset.series === key)!)); });
        rows[2].hidden = true; dragon.hidden = status !== 'read';
      }
      currentList = status;
      books.forEach(book => book.setAttribute('aria-pressed', 'false'));
      controls.forEach(control => control.setAttribute('aria-pressed', String(control.dataset.readingFilter === status)));
      featured = books.find(book => !book.hidden)!;
      bookcase.setAttribute('aria-label', `Example ${status === 'read' ? 'read' : 'to be read'} collection: ${books.filter(book => !book.hidden).length} books on two shelves`);
      hint.textContent = defaultHint; reveal(featured);
    }
    controls.forEach(control => control.addEventListener('click', () => showList(control.dataset.readingFilter!)));
    function finishMove() {
      if (dragging) suppressClickUntil = performance.now() + 250;
      pointerOrigin = null; dragging = null; ghost?.remove(); ghost = null; preview.classList.remove('is-rearranging'); rows.forEach(row => row.classList.remove('drop-target'));
      if (hint.textContent === 'Drop onto a shelf. Everything stays inside its edges.') hint.textContent = defaultHint;
    }
    function dropOn(row: HTMLElement, event: Pick<PointerEvent, 'clientX' | 'clientY' | 'preventDefault' | 'stopPropagation'>) {
      if (!dragging) return;
      event.preventDefault(); event.stopPropagation();
      const item = dragging; const saved = snapshot();
      if (item === plant) {
        const cabinet = bookcase.getBoundingClientRect(); const bounds = row.getBoundingClientRect();
        const width = plant.getBoundingClientRect().width;
        const left = Math.max(bounds.left, Math.min(event.clientX - width / 2, bounds.right - width));
        plant.style.left = `${(left - cabinet.left) / cabinet.width * 100}%`;
        plant.style.right = 'auto';
        plant.style.top = `calc(var(--cabinet-top) + ${row === rows[0] ? 0 : 1} * (var(--book-height) + 20px) + var(--book-height) + 7px - var(--pot-bottom))`;
        hint.textContent = 'A new spot for your plant.';
      } else {
        const candidates = Array.from(row.querySelectorAll<HTMLButtonElement>('[data-book-id], [data-shelf-prop="dragon"]')).filter(other => other !== item && isVisible(other));
        // A pile has a vertical reading order. Use both pointer coordinates so
        // dropping below Insurgent inserts after that book, rather than before the pile.
        const pile = Array.from(row.querySelectorAll<HTMLElement>('.stacked-volumes')).find(stack => {
          const r = stack.getBoundingClientRect();
          return isVisible(stack) && event.clientX >= r.left && event.clientX <= r.right && candidates.some(book => stack.contains(book));
        });
        if (pile && item.dataset.bookId) {
          const pileBooks = candidates.filter(book => pile.contains(book));
          const next = pileBooks.find(book => { const r = book.getBoundingClientRect(); return event.clientY < r.top + r.height / 2; });
          item.dataset.facing = 'horizontal';
          if (next) next.before(item); else pile.append(item);
        } else {
          const units = Array.from(new Set(candidates.map(other => other.closest<HTMLElement>('.stacked-volumes') || other)));
          const next = units.find(unit => { const r = unit.getBoundingClientRect(); return event.clientX < r.left + r.width / 2; });
          if (next) next.before(item);
          else if (units.length) units[units.length - 1].after(item);
          else row.append(item);
        }
        // Empty saga wrappers must not consume space after their last book moves.
        clusters.forEach(cluster => { cluster.hidden = !Array.from(cluster.querySelectorAll<HTMLElement>('[data-book-id], [data-shelf-prop="dragon"]')).some(child => !child.hidden); });
        if (!makeRoom(row, item)) { restore(saved); hint.textContent = 'There is no room left on this shelf, even with the spines together. Try the other shelf.'; }
        else hint.textContent = item === dragon ? 'A new spot for your dragon.' : `${item.dataset.title} has a new place on your shelf.`;
      }
      finishMove();
    }
    // Chromium can otherwise start dragging an SVG image and cancel pointer capture.
    preview.addEventListener('dragstart', event => event.preventDefault(), true);
    // Listen on the window: a release must not depend on the original DOM node
    // retaining pointer capture (Chromium can end it during an image gesture).
    [...books, ...props, stage].forEach(handle => {
      handle.addEventListener('pointerdown', event => {
        if (event.button !== 0 || !event.isPrimary) return;
        event.preventDefault();
        handle.focus({preventScroll: true});
        pointerOrigin = {x: event.clientX, y: event.clientY, id: event.pointerId, type: event.pointerType, item: handle === stage ? displayed || selected || featured : handle as HTMLButtonElement};
      });
    });
    function releaseAt(event: PointerEvent | MouseEvent) {
      if (!pointerOrigin) return;
      if (event instanceof PointerEvent && event.pointerId !== pointerOrigin.id) return;
      pointerOrigin = null;
      if (!dragging) return;
      try {
        const bounds = bookcase.getBoundingClientRect();
        if (event.clientX >= bounds.left && event.clientX <= bounds.right && event.clientY >= bounds.top && event.clientY <= bounds.bottom) {
          const visibleRows = rows.filter(isVisible);
          const nearest = visibleRows.reduce((best, row) => Math.abs(event.clientY - (row.getBoundingClientRect().top + row.getBoundingClientRect().height / 2)) < Math.abs(event.clientY - (best.getBoundingClientRect().top + best.getBoundingClientRect().height / 2)) ? row : best);
          dropOn(nearest, event);
        }
      } finally { finishMove(); }
    }
    window.addEventListener('pointermove', event => {
      if (!pointerOrigin || event.pointerId !== pointerOrigin.id) return;
      // Recover a missed release instead of leaving a floating drag image behind.
      if (dragging && event.pointerType === 'mouse' && event.buttons === 0) { releaseAt(event); return; }
      if (!dragging && Math.hypot(event.clientX - pointerOrigin.x, event.clientY - pointerOrigin.y) > 6) {
        lockCabinet(); dragging = pointerOrigin.item;
        if (dragging.dataset.bookId) select(dragging);
        preview.classList.add('is-rearranging'); hint.textContent = 'Drop onto a shelf. Everything stays inside its edges.';
        ghost = document.createElement('div'); ghost.className = 'shelf-drag-ghost'; ghost.setAttribute('aria-hidden', 'true');
        const image = document.createElement('img'); image.draggable = false;
        image.src = dragging.dataset.cover || (dragging === plant ? '/images/trailing-ivy-cutout.png' : '/images/black-dragon-ornament.png');
        ghost.append(image); preview.append(ghost);
      }
      if (!dragging) return;
      event.preventDefault();
      ghost!.style.left = `${event.clientX}px`; ghost!.style.top = `${event.clientY}px`;
      const target = rows.filter(isVisible).find(row => { const r = row.getBoundingClientRect(); return event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom; });
      rows.forEach(row => row.classList.toggle('drop-target', row === target));
    }, {capture: true});
    window.addEventListener('pointerup', releaseAt, {capture: true});
    window.addEventListener('mouseup', event => { if (pointerOrigin?.type === 'mouse') releaseAt(event); }, {capture: true});
    window.addEventListener('pointercancel', finishMove, {capture: true});
    window.addEventListener('blur', finishMove);
    preview.closest('dialog')?.addEventListener('close', finishMove);
    showList('read');
  });
</script>
<style>
  .shelf-preview { --book-height: 100px; --horizontal-width: 82px; --model-width: 90px; --model-height: 135px; --cabinet-height: calc(var(--book-height) * 2.89 + 58px); --cabinet-top: calc(var(--book-height) * .39 + 21px); --cabinet-side: 35px; }
  .preview-controls { display: flex; align-items: center; justify-content: flex-end; gap: 12px; max-width: 100%; margin: 0 0 9px; }
  .preview-controls p { margin: 0; font: italic 15px Georgia, serif; color: #84917b; }
