---
interface Props { cover:string; title:string; }
const {cover,title}=Astro.props;
---
<div class="opening-book" aria-hidden="true">
  <span class="book-binding"></span><span class="still-page left-page"></span><span class="still-page right-page"></span>
  {[0,1,2].map(i=><span class="turning-page" style={`--page-delay:${i*.7}s`}></span>)}
  <span class="opening-cover"><img src={cover} alt="" width="180" height="270"/><span></span></span>
</div>
<style>
  .opening-book{--leaf-width:100px;--leaf-height:150px;position:relative;width:calc(var(--leaf-width)*2 + 18px);height:calc(var(--leaf-height) + 20px);perspective:850px;transform:rotateX(10deg);transform-style:preserve-3d;}
  .book-binding{position:absolute;left:3px;right:3px;top:7px;height:calc(var(--leaf-height) + 5px);border-radius:3px 3px 7px 7px;background:#34483c;box-shadow:0 13px 14px #31271930;}
  .still-page,.turning-page{position:absolute;top:9px;width:var(--leaf-width);height:var(--leaf-height);border:1px solid #d7c6a4;background:repeating-linear-gradient(0deg,transparent 0 6px,#b5a79044 6px 7px) center 23px/calc(100% - 24px) calc(100% - 45px) no-repeat,linear-gradient(90deg,#d6c9ac,#fff5db 15%,#f7edd4 92%,#e0d3b5);box-shadow:inset 1px 0 #fff9e8;}
  .left-page{left:9px;transform-origin:right;transform:rotateY(5deg);border-radius:3px 0 0 4px;}.right-page{left:calc(var(--leaf-width) + 9px);border-radius:0 3px 4px 0;}
  .turning-page{z-index:3;left:calc(var(--leaf-width) + 9px);transform-origin:left;animation:turn-a-page 3.6s calc(.9s + var(--page-delay)) ease-in-out infinite;backface-visibility:visible;border-radius:0 3px 3px 0;}
  .opening-cover{position:absolute;z-index:5;top:5px;left:calc(var(--leaf-width) + 9px);width:calc(var(--leaf-width) + 3px);height:calc(var(--leaf-height) + 7px);transform-origin:left;transform-style:preserve-3d;animation:open-the-book 1.3s ease-out forwards;}
  .opening-cover img,.opening-cover>span{position:absolute;inset:0;width:100%;height:100%;border-radius:2px;backface-visibility:hidden;}.opening-cover>span{background:linear-gradient(90deg,#cfbd99,#eee1c3);transform:rotateY(180deg);}
  @keyframes open-the-book{from{transform:rotateY(0)}to{transform:rotateY(-165deg)}}
  @keyframes turn-a-page{0%,15%{transform:rotateY(0);z-index:4;}65%,100%{transform:rotateY(-175deg);z-index:1;}}
  @media(prefers-reduced-motion:reduce){.opening-cover{animation:none;transform:rotateY(-165deg);}.turning-page{animation:none;}.opening-book{transform:none;}}
</style>
