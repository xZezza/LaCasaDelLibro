---
// Original generated interpretations; the source fan-art images are not bundled.
---
<div class="library-visitor" data-library-visitor hidden aria-hidden="true">
  <div class="visitor-figure">
    <span class="visitor-pose visitor-closed"></span>
    <span class="visitor-pose visitor-reading"></span>
    <span class="visitor-foot-shadow"></span>
  </div>
  <span class="visitor-name" data-visitor-name></span>
</div>

<script>
  import characters from '../data/library-visitors.json';

  document.querySelectorAll<HTMLElement>('[data-library-visitor]').forEach(visitor => {
    const dialog = visitor.closest<HTMLDialogElement>('dialog');
    const cabinet = visitor.closest<HTMLElement>('[data-bookcase]');
    if (!dialog || !cabinet) return;
    const preview = cabinet.closest<HTMLElement>('[data-shelf-preview]')!;
    const name = visitor.querySelector<HTMLElement>('[data-visitor-name]')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const key = 'the-salon-library-visitors-v1';
    const ids = characters.map(character => character.id);
    let queue: string[] = [], last = '';
    let token = 0;
    let timers: ReturnType<typeof setTimeout>[] = [];
    let highlighted: HTMLElement | null = null;
    try {
      const saved = JSON.parse(localStorage.getItem(key) || '{}');
      if (Array.isArray(saved.queue)) queue = [...new Set<string>(saved.queue.filter((id: unknown) => typeof id === 'string' && ids.includes(id)))];
      if (typeof saved.last === 'string') last = saved.last;
    } catch { /* Private browsing and disabled storage still work in memory. */ }

    function shuffle() {
      const bag = [...ids];
      for (let i = bag.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [bag[i], bag[j]] = [bag[j], bag[i]];
      }
      if (bag.length > 1 && bag[0] === last) [bag[0], bag[1]] = [bag[1], bag[0]];
      return bag;
    }

    function stop() {
      token++;
      timers.forEach(clearTimeout); timers = [];
      visitor.hidden = true;
      delete visitor.dataset.phase;
      delete visitor.dataset.character;
      highlighted?.removeAttribute('data-visitor-book');
      highlighted = null;
    }
    function after(delay: number, callback: () => void) {
      timers.push(setTimeout(callback, delay));
    }

    async function visit() {
      stop();
      if (!dialog!.open || reduceMotion.matches) return;
      const activeToken = token;
      if (!queue.length) queue = shuffle();
      // Try each candidate at most once. A missing image must not break the shelf.
      for (const id of [...queue]) {
        const character = characters.find(item => item.id === id)!;
        const image = new Image(); image.src = character.image;
        try { await image.decode(); } catch { continue; }
        if (activeToken !== token || !dialog!.open || reduceMotion.matches) return;

        const books = [...cabinet!.querySelectorAll<HTMLElement>('[data-book-id]')].filter(book => !book.hidden && book.getClientRects().length > 0);
        const book = books.find(book => character.bookIds.includes(book.dataset.bookId!)) || books[0];
        if (!book) return;
        const frame = cabinet!.getBoundingClientRect(), bounds = book.getBoundingClientRect();
        const size = Math.min(190, Math.max(112, bounds.height * 1.28));
        const x = Math.max(-size * .15, Math.min(frame.width - size * .75, bounds.left - frame.left + bounds.width / 2 - size / 2));
        visitor.style.setProperty('--visitor-art', `url("${character.image}")`);
        visitor.style.setProperty('--visitor-size', `${size}px`);
        visitor.style.left = `${x}px`;
        visitor.style.bottom = `${frame.bottom - bounds.bottom - size * .015}px`;
        visitor.dataset.character = character.id;
        name.textContent = character.name;
        visitor.hidden = false;
        visitor.dataset.phase = 'entering';
        highlighted = book; book.setAttribute('data-visitor-book', 'true');
        queue = queue.filter(candidate => candidate !== id); last = id;
        try { localStorage.setItem(key, JSON.stringify({queue, last})); } catch {}
        after(1550, () => visitor.dataset.phase = 'opening');
        after(2450, () => visitor.dataset.phase = 'reading');
        after(6500, () => visitor.dataset.phase = 'leaving');
        after(7600, stop);
        return;
      }
    }

    new MutationObserver(() => dialog!.open ? void visit() : stop()).observe(dialog, {attributes: true, attributeFilter: ['open']});
    dialog.addEventListener('close', stop);
    preview.addEventListener('pointerdown', event => {
      if ((event.target as Element).closest('[data-book-id],[data-shelf-prop],[data-reading-filter],[data-model-stage]')) stop();
    }, {capture: true});
    preview.addEventListener('keydown', event => { if (event.key !== 'Tab') stop(); }, {capture: true});
    reduceMotion.addEventListener('change', () => { if (reduceMotion.matches) stop(); });
    window.addEventListener('resize', stop);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    if (dialog.open) void visit();
  });
</script>

<style>
  .library-visitor { position: absolute; z-index: 9; width: var(--visitor-size,160px); height: var(--visitor-size,160px); pointer-events: none; user-select: none; }
  .library-visitor[hidden] { display: none; }
  .visitor-figure { width: 100%; height: 100%; position: relative; filter: drop-shadow(2px 3px 2px #29170e55); transform-origin: center bottom; }
  .visitor-pose { position: absolute; inset: 0; background-image: var(--visitor-art); background-repeat: no-repeat; background-size: 200% 100%; transition: opacity .55s ease; }
  .visitor-closed { background-position: left center; opacity: 1; }
  .visitor-reading { background-position: right center; opacity: 0; }
  .visitor-foot-shadow { position: absolute; z-index: -1; bottom: 1%; left: 32%; width: 35%; height: 3%; border-radius: 50%; background: #38210c66; filter: blur(2px); }
  .visitor-name { position: absolute; left: 50%; top: 100%; transform: translateX(-50%); white-space: nowrap; padding: 3px 9px; border: 1px solid #d2b77a88; border-radius: 20px; background: #fff7e9e8; color: #4d5543; font: italic 10px/1.2 Georgia,serif; box-shadow: 0 2px 6px #402b1c22; opacity: 0; transition: opacity .3s; }
  [data-phase="entering"] .visitor-figure { animation: visitor-arrives 1.55s ease-out both; }
  [data-phase="opening"] .visitor-reading,[data-phase="reading"] .visitor-reading,[data-phase="leaving"] .visitor-reading { opacity: 1; }
  [data-phase="opening"] .visitor-closed,[data-phase="reading"] .visitor-closed,[data-phase="leaving"] .visitor-closed { opacity: 0; }
  [data-phase="opening"] .visitor-name,[data-phase="reading"] .visitor-name { opacity: 1; }
  [data-phase="reading"] .visitor-figure { animation: visitor-breathes 3.6s ease-in-out infinite; }
  [data-phase="leaving"] { animation: visitor-leaves 1.1s ease-in both; }
  @keyframes visitor-arrives { 0% { opacity: 0; transform: translateX(-65px) scale(.94); } 30% { opacity: 1; transform: translate(-36px,-2px) scale(.97); } 65% { transform: translate(-12px,1px); } 100% { opacity: 1; transform: translate(0,0); } }
  @keyframes visitor-breathes { 50% { transform: translateY(-1px) rotate(.35deg); } }
  @keyframes visitor-leaves { to { opacity: 0; transform: translate(25px,3px) scale(.98); } }
  @media(max-width:650px) { .visitor-name { font-size: 8px; padding: 2px 7px; } }
  @media(prefers-reduced-motion:reduce) { .library-visitor { display: none !important; } }
</style>
