---
import GuestQuote from "../QuoteText/GuestQuote.jsx";
import DecorativeFlower from "../shared/DecorativeFlower.jsx";
import "./ClosingQuote.css";
import ThreadsAction from "./ThreadsAction.jsx";
import "../shared/actions.css";
import "../shared/typography.css";

const { showNotes = true } = Astro.props;
---

<section id="follow" class="salon-follow" aria-labelledby="follow-title">
  <div class="follow-panel">
    <span class="follow-bookmark" aria-hidden="true"></span>
    <div class="follow-flower" aria-hidden="true">
      <DecorativeFlower colour="lilac" />
    </div>

    <GuestQuote client:load
      name="follow-quote"
      placement="throne"
      text="You could rattle the stars. You could do anything, if only you dared."
      author="Sarah J. Maas"
      book="Throne of Glass"
    />
    <h2 id="follow-title" class="follow-title">Be there from the first chapter.</h2>
    <p class="follow-description">The Salon is in development. Follow along for a first look.</p>
    <div class="follow-socials">
      <a href="https://www.instagram.com/therealbooksalon/" class="follow-social salon-marker-action salon-marker-primary">
        <span class="salon-marker-text">Instagram</span>
      </a>
      <ThreadsAction client:load />
    </div>
    {showNotes && <p class="follow-signoff">see you inside</p>}
  </div>
</section>

<style>
  @layer components {
    .follow-bookmark {
      position: absolute;
      top: -8px;
      left: clamp(30px, 8vw, 90px);
      width: 28px;
      height: 140px;
      background: light-dark(oklch(0.55 0.09 300), oklch(0.73 0.09 300));
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
    }

    .follow-flower {
      position: absolute;
      bottom: -30px;
      right: clamp(10px, 5vw, 60px);
      width: 130px;
      height: 130px;
      transform: rotate(12deg);
      pointer-events: none;
    }

    .follow-title {
      margin: 18px 0 0;
      font-family: "Cormorant Garamond", serif;
      font-weight: 400;
      font-size: clamp(32px, 3.7vw, 48px);
      line-height: 1;
      max-width: 16ch;
      text-wrap: balance;
    }

    .follow-description {
      margin: 22px 0 0;
      max-width: 520px;
      font-size: 16px;
      line-height: 1.7;
      font-weight: 300;
      color: light-dark(oklch(0.38 0.03 305), oklch(0.79 0.02 85));
      text-wrap: pretty;
    }

    .follow-socials :global(.follow-social) {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 24px;
      font-family: inherit;
      font-size: 15px;
    }

    .follow-socials {
      margin-top: 22px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: clamp(24px, 4vw, 40px);
      row-gap: 12px;
    }

    .follow-signoff {
      margin: 26px 0 0;
      font-family: "Kalam", cursive;
      font-weight: 300;
      font-size: 20px;
      color: light-dark(oklch(0.55 0.09 300), oklch(0.73 0.09 300));
    }

    .follow-panel {
      position: relative;
      border-radius: 6px;
      padding: clamp(28px, 4vw, 48px) clamp(24px, 5vw, 72px);
      text-align: center;
      background: light-dark(oklch(0.925 0.025 80), oklch(0.175 0.028 15));
      box-shadow: inset 0 0 0 1px light-dark(oklch(0.25 0.035 305 / 0.08), oklch(0.92 0.02 85 / 0.08)),
        0 30px 60px -40px light-dark(oklch(0.25 0.035 305 / 0.4), oklch(0.92 0.02 85 / 0.4));
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .salon-follow {
      position: relative;
      z-index: 1;
      max-width: var(--page-max-width, 1200px);
      margin: 0 auto;
      padding: 0 clamp(20px, 4vw, 48px) clamp(70px, 9vw, 110px);
    }
  }

  @layer responsive {
    @media (width > 960px) {
      .salon-follow { padding-bottom: clamp(28px, 3vw, 42px); }
      .follow-panel { padding-block: 24px 28px; }
      .follow-bookmark { width: 24px; height: 104px; }
      .follow-flower { bottom: -18px; width: 100px; height: 100px; }
      .follow-title { margin-top: 0; }
      .follow-description { margin-top: 14px; }
      .follow-socials { margin-top: 12px; }
      .follow-socials :global(.follow-social) { padding-block: 4px; }
      .follow-signoff { margin-top: 12px; }
    }

    @media (max-width: 650px) {
      .salon-follow { padding-bottom: var(--mobile-section-gap); }
      .follow-bookmark {
        top: -4px;
        left: 8px;
        width: 10px;
        height: 44px;
      }

      .follow-title {
        margin-top: 4px;
        font-size: clamp(28px, 8vw, 34px);
        line-height: 1.08;
      }

      .follow-description {
        max-width: 29ch;
        margin-top: 10px;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.5;
        text-wrap: balance;
      }

      .follow-socials { margin-top: 12px; gap: 4px 20px; }
      .follow-socials :global(.follow-social) { padding: 0 6px; font-size: 14px; }
      .follow-social.salon-marker-primary .salon-marker-text::before { transform: rotate(-1.5deg) scaleX(1); }
      .follow-signoff { margin-top: 12px; font-size: 17px; }
      .follow-flower { bottom: -20px; width: 82px; height: 82px; }
    }
  }
</style>
