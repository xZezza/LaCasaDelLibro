---
import ClosingQuote from "./ClosingQuote.jsx";
import ThreadsAction from "./ThreadsAction.jsx";
import "../shared/actions.css";
import "../shared/typography.css";
import "./styles.css";

const { showNotes = true } = Astro.props;
const petals = [0, 72, 144, 216, 288];
---

<section id="follow" class="salon-follow" aria-labelledby="follow-title">
  <div class="follow-panel">
    <span class="follow-bookmark" aria-hidden="true"></span>
    <div class="follow-flower" aria-hidden="true">
      <svg viewBox="0 0 120 120" width="100%" height="100%" class="salon-s86">
        <path d="M60 64 C 58 84, 50 98, 38 114" fill="none" stroke="light-dark(oklch(0.55 0.07 130), oklch(0.73 0.07 130))" stroke-width="2.2" stroke-linecap="round" />
        <path d="M50 92 C 36 88, 28 94, 22 102 C 34 104, 44 100, 50 92 Z" fill="light-dark(oklch(0.66 0.07 135), oklch(0.84 0.07 135))" opacity=".85" />
        <path d="M56 80 C 68 72, 80 74, 88 80 C 78 88, 66 88, 56 80 Z" fill="light-dark(oklch(0.62 0.07 135), oklch(0.8 0.07 135))" opacity=".8" />
        {petals.map(angle => <ellipse cx="60" cy="38" rx="11" ry="22" fill="oklch(0.7 0.08 295)" opacity=".88" transform={`rotate(${angle} 60 60)`} />)}
        {petals.map(angle => <ellipse cx="60" cy="44" rx="6" ry="13" fill="oklch(0.86 0.05 295)" opacity=".6" transform={`rotate(${angle + 36} 60 60)`} />)}
        <circle cx="60" cy="60" r="8" fill="light-dark(oklch(0.74 0.12 85), oklch(0.86 0.12 85))" />
        <circle cx="57" cy="57" r="2" fill="light-dark(oklch(0.95 0.06 90), oklch(0.23 0.042 90))" opacity=".8" />
      </svg>
    </div>

    <ClosingQuote client:load />
    <h2 id="follow-title" class="follow-title">Be there from the first chapter.</h2>
    <p class="follow-description">The Salon is in development. Follow along for a first look.</p>
    <div class="follow-socials">
      <a href="https://www.instagram.com/therealbooksalon/" class="follow-social salon-marker-action salon-marker-primary">
        <span class="salon-marker-text">Instagram</span>
      </a>
      <ThreadsAction client:load />
    </div>
    {showNotes && <p class="follow-signoff">see you inside</p>}
  </div>
</section>
