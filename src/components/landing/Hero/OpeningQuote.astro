---
import QuoteText from "../QuoteText/index.jsx";
---

<div class="hero-opening-quote">
  <div class="hero-opening-quote-inner">
    <figure class="salon-opening-quote quote-reveal" data-visible="true" data-reveal="false">
      <span class="salon-s24" aria-hidden="true"></span>
      <span class="salon-s25" aria-hidden="true"></span>
      <QuoteText text="One must always be careful of books… and what is inside them, for words have the power to change us." className="hero-opening-quote-text" />
      <figcaption class="hero-opening-quote-credit">
        Cassandra Clare · <cite class="salon-s28">Clockwork Angel</cite>
      </figcaption>
    </figure>
  </div>
</div>

<script>
  const quote = document.querySelector<HTMLElement>(".salon-opening-quote");

  if (quote && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      const entry = entries.at(-1);
      if (!entry) return;

      if (entry.intersectionRatio >= 0.3) {
        quote.dataset.reveal = "true";
      } else if (entry.intersectionRatio === 0) {
        quote.dataset.reveal = "false";
      }
    }, { threshold: [0, 0.3], rootMargin: "0px 0px -48px 0px" });

    observer.observe(quote);
  } else if (quote) {
    quote.dataset.reveal = "true";
  }
</script>

<style>
  @layer components {
    .hero-opening-quote {
      position: relative;
      z-index: 1;
      padding-top: clamp(40px, 4vw, 60px);
    }

    .hero-opening-quote-inner {
      max-width: var(--page-max-width, 1440px);
      margin-inline: auto;
      padding-inline: clamp(20px, 4vw, 48px);
    }

    .salon-opening-quote > :global(.hero-opening-quote-text) {
      margin: 0;
      font-family: "Cormorant Garamond", serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(22px, 2.6vw, 36px);
      line-height: 1.2;
      color: light-dark(oklch(0.3 0.04 305), oklch(0.87 0.02 85));
      text-wrap: balance;
      column-gap: 0.26em;
    }

    .hero-opening-quote-credit {
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: light-dark(oklch(0.45 0.03 305), oklch(0.72 0.02 85));
      transition: opacity 0.8s ease 1.1s;
    }

    .salon-opening-quote {
      position: relative;
      margin: calc(-1 * clamp(48px, 8vw, 112px)) 0 0;
      padding: clamp(18px, 2.4vw, 28px) 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      text-align: center;
    }

    .salon-opening-quote :is(.salon-s24, .salon-s25) {
      inset-inline: 0;
      margin-inline: auto;
    }

    .salon-opening-quote .salon-s24 {
      width: clamp(140px, 17vw, 240px);
    }

    .salon-opening-quote .salon-s25 {
      width: clamp(115px, 14vw, 200px);
    }
  }

  @layer responsive {
    @media (max-width: 650px) {
      .hero-opening-quote { padding-top: var(--mobile-section-gap); }

      .salon-opening-quote {
        margin-top: calc(-1 * var(--mobile-section-gap));
        padding: var(--mobile-copy-gap) 12px;
        gap: 14px;
      }

      .salon-opening-quote :is(.salon-s24, .salon-s25) { width: 100%; }
      .salon-opening-quote > :global(.hero-opening-quote-text) { max-width: 34ch; font-size: clamp(22px, 6.4vw, 28px); }
      .salon-opening-quote :is(.hero-opening-quote-credit, .salon-s28) { font-size: 11px; }
    }
  }
</style>
