---
import "./styles.css";
import StoryGuests from "../StoryGuests/index.jsx";
import OpeningQuote from "./OpeningQuote.astro";
import { BREAKPOINTS, MEDIA_QUERIES } from "../../../config/breakpoints.js";
import { imageAsset } from "../../../lib/image-assets.js";

const roomMedia = `(width > ${BREAKPOINTS.phoneMax}px)`;
const journalImage = imageAsset("/images/hero/reading-journal-fantasy.png");
---

<div class="salon-s23 salon-hero">
  <div class="salon-hero-stage">
    <div class="salon-s8">
      <div class="salon-s7">
        <div class="salon-s6" role="img" aria-label="A cozy reading room with a bookcase decorated with flowers and fairy lights"></div>
      </div>
    </div>
    <div class="salon-s9"></div>
    <header id="top" class="salon-s22">
      <div class="salon-s21">
        <div class="salon-s11">
          <span class="salon-s10"></span>
          Now in development
        </div>
        <h1 class="salon-s15">
          A story doesn’t end when you close <em class="salon-s14">the last page.<span aria-hidden="true" class="salon-s12"></span><span aria-hidden="true" class="salon-s13"></span></em>
        </h1>
        <p class="salon-s16">
          <span class="hero-copy-wide">The Salon is a home for your books and the feelings they leave behind. Arrange your shelves, keep a private journal for every story, and find people who want to talk about it as much as you do.</span>
          <span class="hero-copy-phone">Your books. Your memories. Your people. Arrange your shelves and keep a journal for every story.</span>
        </p>
        <p class="salon-s20">made for fantasy, romantasy &amp; dystopian worlds · 15+<br />open to every story you love</p>
      </div>
    </header>
    <picture class="hero-mobile-illustration">
      <source media={MEDIA_QUERIES.phone} srcset={journalImage} />
      <img
        src="/images/hero/reading-room.jpg"
        width="1355"
        height="1161"
        alt="An open reading journal with handwritten memories, a pressed flower and a tiny fantasy world rising from its pages"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <StoryGuests client:media={roomMedia} group="all" placement="hero" />
  </div>
</div>
<OpeningQuote />
