---
const { placement = 'hero' } = Astro.props as { placement?: 'hero' | 'preview' };
---
<button class:list={['fireplace-sound', `sound-${placement}`]} type="button" data-fireplace-toggle aria-pressed="false" aria-label="Turn on fireplace sound" title="Turn on fireplace sound">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m11 5-5 4H3v6h3l5 4Z"/><path class="sound-on" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/><path class="sound-off" d="m16 10 4 4m0-4-4 4"/></svg>
  <span>Fireplace sound</span><small data-fireplace-state aria-hidden="true">Off</small>
</button>
<script>
  const fireAudio = document.querySelector<HTMLAudioElement>('[data-fireplace-audio]')!;
  const soundButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-fireplace-toggle]'));
  let playRequest = 0;
  fireAudio.volume = .18;
  function syncFireSound() {
    const playing = !fireAudio.paused && !fireAudio.ended;
    soundButtons.forEach(button => {
      button.setAttribute('aria-pressed', String(playing));
      const label = playing ? 'Mute fireplace sound' : 'Turn on fireplace sound';
      button.setAttribute('aria-label', label); button.title = label;
      button.querySelector('[data-fireplace-state]')!.textContent = playing ? 'On' : 'Off';
    });
  }
  function stopFireSound() { playRequest++; fireAudio.pause(); syncFireSound(); }
  soundButtons.forEach(button => button.addEventListener('click', async () => {
    if (!fireAudio.paused) { stopFireSound(); return; }
    if (document.documentElement.dataset.scene !== 'night' && !button.closest('dialog[open]')) return;
    const request = ++playRequest;
    soundButtons.forEach(control => { control.disabled = true; });
    try {
      // Audio starts only from this explicit gesture, never on page load.
      await fireAudio.play();
      if (request !== playRequest) fireAudio.pause();
    } catch {
      fireAudio.pause();
      soundButtons.forEach(control => { control.title = 'Sound unavailable. Tap to try again.'; });
    } finally {
      soundButtons.forEach(control => { control.disabled = false; });
      syncFireSound();
    }
  }));
  fireAudio.addEventListener('play', syncFireSound);
  fireAudio.addEventListener('pause', syncFireSound);
  fireAudio.addEventListener('error', syncFireSound);
  window.addEventListener('salon:scene-change', event => { if ((event as CustomEvent).detail === 'day') stopFireSound(); });
  document.querySelector('#shelf-dialog')?.addEventListener('close', () => { if (document.documentElement.dataset.scene === 'day') stopFireSound(); });
  window.addEventListener('pagehide', stopFireSound);
</script>
<style>
  .fireplace-sound { display: inline-flex; align-items: center; gap: 7px; min-height: 34px; padding: 7px 11px; border: 1px solid #c8ad8170; border-radius: 22px; background: #fff7e6b3; backdrop-filter: blur(8px); color: #3e5949; font-size: 10px; line-height: 1.2; box-shadow: 0 2px 8px #40290d1c; cursor: pointer; }
  .sound-hero { position: absolute; z-index: 3; right: 22px; bottom: 20px; }
  .sound-preview { position: absolute; z-index: 8; right: 18px; bottom: 13px; }
  .fireplace-sound svg { width: 17px; height: 17px; flex-shrink: 0; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .fireplace-sound small { font-size: 8px; letter-spacing: .6px; text-transform: uppercase; color: #806b49; }
  .sound-on { display: none; }.fireplace-sound[aria-pressed="true"] .sound-on { display: block; }.fireplace-sound[aria-pressed="true"] .sound-off { display: none; }
  .fireplace-sound[aria-pressed="true"] { background: #fdf1d3dc; border-color: #b29659b3; }
  .fireplace-sound:hover { background: #fff8e9e6; }.fireplace-sound:focus-visible { outline: 2px solid #3e5949; outline-offset: 3px; }
  :global(html[data-scene="day"]) .sound-hero { display: none; }
  @media (max-width: 650px) { .sound-hero { right: 17px; bottom: 60px; }.sound-preview { right: 16px; bottom: 12px; }.fireplace-sound { font-size: 9px; min-height: 34px; }.sound-preview { position: static; display: flex; width: fit-content; margin: 12px auto 0; } }
</style>
