---
import BookshelfPreview from '../components/BookshelfPreview.astro';
import WindowSnow from '../components/WindowSnow.astro';
import PopularBooks from '../components/PopularBooks.astro';
import DaySwing from '../components/DaySwing.astro';
import ReadingPreview from '../components/ReadingPreview.astro';
// Social links will be added when the real URLs are supplied.
const pageTitle = 'The Salon | Fantasy Bookshelf & Reading Journal';
const description = 'A home for the stories that warm your heart. Discover our vision for a personal 3D bookshelf, private reading journal and fantasy reading community.';
---

<!doctype html>
<html lang="en" data-scene="night">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>try { const scene = localStorage.getItem('the-salon-scene'); if (scene === 'day' || scene === 'night') document.documentElement.dataset.scene = scene; } catch {}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Keep this draft out of search results until the full landing is ready. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#345343" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <a class="brand" href="#" aria-label="The Salon, home">
        <img class="brand-mark" src="/images/the-salon-mark.svg" alt="" width="68" height="40" aria-hidden="true"/>
        <span>The Salon</span>
      </a>
      <nav aria-label="Main navigation">
        <a class="nav-link" href="#the-idea">The experience</a>
        <button class="nav-link" type="button" data-open-shelf>Explore the library <span aria-hidden="true">↗</span></button>
        <div class="scene-switch" role="group" aria-label="Choose your reading atmosphere">
          <button type="button" data-scene-choice="day" aria-pressed="false" aria-label="Day mode" title="Day mode"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
          <button type="button" data-scene-choice="night" aria-pressed="true" aria-label="Night mode" title="Night mode"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.6 14.7A9 9 0 0 1 9.3 3.4a9 9 0 1 0 11.3 11.3Z"/></svg></button>
        </div>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="status"><svg viewBox="0 0 20 24" aria-hidden="true" fill="none"><path d="m10 2 7 9-7 11-7-11Z" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="1.5" fill="currentColor"/><path d="M10 12v10M5 6l10 0" stroke="currentColor" stroke-width="1.2"/></svg>YOUR NEXT CHAPTER STARTS HERE</div>
          <h1 id="hero-title">A home for<br />the stories<br />that <em>warm</em><br />your heart.</h1>
          <p class="intro">A personal 3D bookshelf, a private reading journal, and a community for fantasy readers.</p>
          <a class="button" href="#the-idea">See how it works <span aria-hidden="true">↗</span></a>
          <p class="small-note">A reading app in the making.</p>
        </div>

        <figure class="hero-world">
          <img
            class="world-image scene-night"
            src="/images/library-winter-armchair-forward.png"
            width="1872"
            height="839"
            alt="A cosy winter reading room with a tall illuminated wooden bookshelf, a fireplace, an inviting cream armchair and snow falling outside the windows."
            fetchpriority="high"
          />
          <img class="world-image scene-day" src="/images/Libreria_3D_foresta_lucine.png" width="1872" height="840" alt="An enchanted forest reading nook with a tall wooden bookshelf, flowers, fairy lights and a gently swaying hanging chair." />
          <DaySwing />
          <WindowSnow />
          <button class="closer" type="button" data-open-shelf><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><g stroke="#fffdf2" stroke-width="5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></g><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></g></svg><span>EXPLORE THE LIBRARY</span></button>
        </figure>
      </section>

      <PopularBooks />

      <section class="idea" id="the-idea" aria-labelledby="idea-title">
        <ReadingPreview />
      </section>
    </main>

    <footer class="footer"><span>The Salon</span><p>A reading app in development, made with a love of stories.</p><a href="#">Back to the first page ↑</a></footer>

    <dialog id="shelf-dialog" aria-label="Interactive bookshelf preview">
      <button class="close-dialog" type="button" data-close-shelf aria-label="Close bookshelf preview"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg></button>
      <BookshelfPreview />
    </dialog>

    <script>
      const sceneChoices = document.querySelectorAll<HTMLButtonElement>('[data-scene-choice]');
      function chooseScene(scene: string) { document.documentElement.dataset.scene = scene; sceneChoices.forEach(button => button.setAttribute('aria-pressed',String(button.dataset.sceneChoice === scene))); try { localStorage.setItem('the-salon-scene',scene); } catch {} }
      sceneChoices.forEach(button => button.addEventListener('click',()=>chooseScene(button.dataset.sceneChoice!)));
      chooseScene(document.documentElement.dataset.scene || 'night');
      const dialog = document.querySelector<HTMLDialogElement>('#shelf-dialog');
      const closeButton = document.querySelector<HTMLButtonElement>('[data-close-shelf]');
      document.querySelectorAll<HTMLButtonElement>('[data-open-shelf]').forEach((button) => {
        button.addEventListener('click', () => dialog?.showModal());
      });
      closeButton?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog?.addEventListener('close', () => document.body.classList.remove('dialog-open'));
      document.querySelectorAll('[data-open-shelf]').forEach((button) => button.addEventListener('click', () => document.body.classList.add('dialog-open')));
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 2rem; }
  :global(body) { margin: 0; color: #304b3e; background: #f8f6ef; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(body.dialog-open) { overflow: hidden; }
  :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
  :global(button) { font: inherit; cursor: pointer; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(:focus-visible) { outline: 3px solid #866180; outline-offset: 5px; }
  :global(::selection) { background: #e9d6df; color: #304b3e; }
  .skip-link { position: absolute; z-index: 20; top: -5rem; left: 1rem; padding: 1rem; background: #fffdf7; }
  .skip-link:focus { top: 1rem; }
  .header { position: absolute; inset: 0 0 auto; z-index: 10; width: 100%; max-width: none; margin: 0; min-height: 70px; padding: 11px max(5.5%, calc((100vw - 1350px) / 2)); background: rgba(248,246,239,.52); backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px); border-bottom: 1px solid #fffaf23d; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: flex; align-items: center; gap: 13px; flex-shrink: 0; font-family: Baskerville, Georgia, 'Times New Roman', serif; font-size: 27px; letter-spacing: -.8px; }
  .brand-mark { width: 68px; height: 40px; object-fit: contain; }
  nav { display: flex; align-items: center; gap: 34px; }
  .nav-link { padding: 12px 0; border: 0; background: none; color: #425b4d; font-size: 13px; }
  .nav-link span { display: inline-block; margin-left: 7px; }
  .nav-link:hover { color: #805a6b; }
  .hero { position: relative; isolation: isolate; display: flex; align-items: center; width: 100%; min-height: max(720px, calc(100vw * 839 / 1874 + 70px)); margin: 0; padding: 112px max(5.5%, calc((100vw - 1350px) / 2)) 65px; overflow: hidden; }
  .hero-copy { position: relative; z-index: 2; width: min(48%, 580px); padding: 0; }
  .status { display: inline-flex; align-items: center; gap: 9px; color: #546b56; font-size: 9px; font-weight: 650; letter-spacing: 1.65px; }
  .status > svg { width: 14px; height: 18px; flex-shrink: 0; color: #8f794d; transform: rotate(25deg); }
  h1 { max-width: 600px; margin: 27px 0 26px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(66px, 5.8vw, 96px); line-height: 1.01; font-weight: 400; letter-spacing: -5px; }
  h1 em { font-weight: 400; color: #7c8e71; }
  .intro { max-width: 350px; margin: 0; color: #5b695d; font-size: 15px; line-height: 1.8; }
  .invitation { margin: 13px 0 26px; color: #6e776c; font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-size: 17px; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 42px; min-height: 52px; padding: 16px 22px; border: 1px solid #3e5d4a; border-radius: 7px; background: #3e5d4a; color: #fffdf7; font-size: 12px; font-weight: 600; transition: background .2s, transform .2s; }
  .button:hover { background: #304b3e; transform: translateY(-2px); }
  .button span { font-size: 18px; line-height: 1; }
  .small-note { display: flex; align-items: center; gap: 8px; margin-top: 21px; font-size: 10px; line-height: 1.6; color: #737c6e; }
  .tiny-flower { color: #977481; font-size: 18px; }
  .hero-world { position: absolute; z-index: 0; inset: 0; margin: 0; overflow: hidden; background: #e8e4d3; isolation: isolate; container-type: size; }
  .hero-world::after { content: ''; position: absolute; pointer-events: none; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(248,246,239,.98) 0%, rgba(248,246,239,.94) 23%, rgba(248,246,239,.74) 36%, rgba(248,246,239,.16) 53%, transparent 68%); }
  .world-image { position: absolute; z-index: -2; top: auto; bottom: 0; left: 0; width: 100%; height: calc(100cqw * 839 / 1874); object-fit: fill; object-position: center; mask-image: linear-gradient(180deg,transparent,#000 24px); }
  .hero-world::before { content: ""; position: absolute; z-index: -3; inset: 0; background: #d9bc96 url("/images/library-night-canopy.png") top center / 100% auto no-repeat; }
  :global(html[data-scene="day"]) .hero-world::before { background: #f2eee1 url("/images/library-day-canopy.png") top center / 100% auto no-repeat; }
  .scene-day { opacity: 0; }.scene-night { opacity: 1; }:global(html[data-scene='day']) .scene-day { opacity: 1; }:global(html[data-scene='day']) .scene-night { opacity: 0; }
  .scene-switch { display: flex; gap: 3px; padding: 3px; border: 1px solid #d3dbc7; border-radius: 24px; background: #e7ecdf99; margin-left: -12px; }.scene-switch button { display: grid; place-items: center; width: 31px; height: 31px; padding: 6px; border: 0; border-radius: 50%; background: transparent; color: #728269; }.scene-switch button[aria-pressed='true'] { color: #fff8e8; background: #4c6552; }.scene-switch svg { width: 19px; height: 19px; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .closer { position: absolute; top: auto; bottom: 10px; left: calc(100cqw * 908 / 1874); width: max-content; max-width: 90%; transform: translateX(-50%); display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 12px 3px; border: 0; border-radius: 0; background: transparent; color: #153d2c; text-shadow: 0 1px 0 #fff7df, 0 0 5px #fff7df, 0 0 12px #fff7df; font-size: 17px; letter-spacing: 2.7px; font-weight: 750; -webkit-text-stroke: 3px #fffdf2; paint-order: stroke fill; transform-origin: center; animation: library-breathe 4.2s ease-in-out infinite; transition: color .2s; }
  .closer svg { position: absolute; left: -34px; top: 50%; transform: translateY(-50%); width: 23px; height: 23px; filter: drop-shadow(0 0 3px #fff7df) drop-shadow(0 0 6px #fff7df); }
  .closer:hover { color: #081f16; animation-play-state: paused; }
  .closer:focus-visible { animation-play-state: paused; }
  @keyframes library-breathe { 0%,100% { transform: translateX(-50%) scale(.97); opacity: .90; } 50% { transform: translateX(-50%) scale(1.10); opacity: 1; } }
  .closer:focus-visible { outline: 2px solid #fff6d9; outline-offset: 5px; }
  figcaption { position: absolute; bottom: 29px; left: calc(100cqw * 908 / 1874); transform: translateX(-50%); width: 350px; text-align: center; font-size: 9px; letter-spacing: .25px; color: #fffdf7; text-shadow: 0 1px 3px #3b3b2a; }
  .idea { max-width: 1350px; margin: 20px auto 0; padding: 64px 4% 64px; border-top: 1px solid #dfe3d5; }
  .section-intro { display: grid; grid-template-columns: 1fr .85fr; column-gap: 12%; align-items: center; }
  .eyebrow { color: #677a5e; font-size: 9px; font-weight: 600; letter-spacing: 1.7px; line-height: 1.6; }
  .section-intro .eyebrow { grid-column: 1 / -1; margin: 0 0 23px; }
  h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(34px, 3.5vw, 50px); line-height: 1.13; font-weight: 400; letter-spacing: -1.8px; }
  h2 em { color: #7c8e71; }
  .section-intro > p:last-child { margin: 0; color: #66705f; font-size: 14px; line-height: 1.9; }
  h3 { margin: 18px 0 13px; font-family: Baskerville, Georgia, 'Times New Roman', serif; font-size: 27px; line-height: 1.3; font-weight: 400; letter-spacing: -.7px; }
  .footer { max-width: 1350px; padding: 30px 4%; margin: auto; display: flex; align-items: center; gap: 30px; border-top: 1px solid #dfe3d5; color: #6e7767; }
  .footer > span { font-family: Georgia, 'Times New Roman', serif; font-size: 18px; color: #425b4d; }
  .footer p, .footer a { margin: 0; font-size: 10px; line-height: 1.7; }
  .footer a { margin-left: auto; }
  dialog { width: min(800px, 96vw); max-height: 94dvh; padding: 50px 38px 18px; border: 1px solid #d3c7ad; border-radius: 22px; background: linear-gradient(180deg,#fff9e84d,#fff2d63b),url('/images/cozy-library-room.png') center/cover; color: #304b3e; box-shadow: 0 20px 100px #1c2e3b33; }
  dialog::backdrop { background: rgba(28, 42, 32, .7); backdrop-filter: blur(5px); }
  .close-dialog { position: absolute; z-index: 10; top: 12px; right: 12px; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border-radius: 50%; border: 1px solid #b79b6e80; background: #fff8e86b; color: #3e5949; box-shadow: 0 2px 7px #6b48241a,inset 0 1px 0 #fffdf3b3; backdrop-filter: blur(6px); line-height: 0; transition: background .18s ease,box-shadow .18s ease; }
  .close-dialog svg { display: block; width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; pointer-events: none; }
  .close-dialog:hover { background: #fff9eea3; box-shadow: 0 3px 9px #6b48242b,inset 0 1px 0 #fffdf3; }
  .close-dialog:focus-visible { outline: 2px solid #3e5949; outline-offset: 3px; }
  dialog > img { display: block; width: 100%; height: auto; border-radius: 9px; }

  @media (max-width: 960px) {
    .header { min-height: 95px; padding: 20px 5%; }
    .brand { font-size: 23px; }
    .hero { padding: 105px 5% 52px; min-height: max(720px, calc(100vw * 839 / 1874 + 70px)); }
    .hero-copy { width: min(53%, 490px); }
    h1 { font-size: 66px; letter-spacing: -3.6px; }
    .hero-world::after { background: linear-gradient(90deg, rgba(248,246,239,.98), rgba(248,246,239,.90) 28%, rgba(248,246,239,.48) 48%, transparent 75%); }
    .closer { font-size: 15px; }
  }
  @media (max-width: 960px) {
    .header { min-height: 62px; padding: 9px 22px; gap: 12px; }
    .brand { font-size: 23px; }
    .brand-mark { width: 48px; height: 34px; }
    nav { gap: 14px; }.scene-switch { margin-left: 0; }.scene-switch button { width: 29px; height: 29px; }
    nav > button { display: none; }
    .nav-link { font-size: 11px; white-space: nowrap; }
    .hero { display: block; min-height: 0; padding: 95px 26px 660px; }
    .hero-copy { width: 100%; padding: 0; }
    .status { font-size: 8px; letter-spacing: 1.2px; }
    h1 { margin: 25px 0 23px; font-size: clamp(60px, 13.5vw, 88px); line-height: 1.02; letter-spacing: -3.5px; }
    .intro { max-width: 420px; font-size: 14px; }
    .invitation { font-size: 16px; margin-bottom: 22px; }
    .small-note { margin-top: 17px; font-size: 9px; }
    .world-image { top: auto; bottom: 0; height: 680px; object-fit: cover; object-position: center; mask-image: none; }
    .hero-world::after { background: linear-gradient(180deg, #f8f6ef 0%, #f8f6ef 39%, rgba(248,246,239,.88) 47%, rgba(248,246,239,.12) 58%, transparent 70%); }
    .closer { left: calc(50% - 23.5px); top: auto; bottom: 10px; transform: translateX(-50%); font-size: 13px; letter-spacing: 1.8px; padding: 12px 3px; }
    figcaption { left: 50%; right: auto; bottom: 25px; width: calc(100% - 40px); }
    .idea { margin: 25px 24px 0; padding: 44px 2px 42px; }
    .section-intro { display: block; }
    .section-intro .eyebrow { font-size: 8px; margin-bottom: 17px; }
    h2 { font-size: 39px; }
    .section-intro > p:last-child { margin-top: 24px; font-size: 13px; }
    h3 { margin-top: 13px; font-size: 25px; }
    .footer { margin: 0 24px; padding: 24px 0; align-items: flex-start; flex-direction: column; gap: 12px; }
    .footer a { margin-left: 0; }
    dialog { padding: 54px 17px 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(*), :global(*::before), :global(*::after) { transition: none !important; animation: none !important; }
  }
</style>
